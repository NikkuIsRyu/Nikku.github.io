---
// Fine-tuning progress player for the Voice ML project page.
// Every stage rendered the same sentences with the same seed, so only the model differs.
// Audio files: /audio/voice-ml/<stage>_<sentence>.mp3
interface Stage {
	id: string;
	label: string;
	model: string;
	description: string;
}
interface Sentence {
	id: string;
	label: string;
	hanzi: string;
	pinyin: string;
	translation: string;
}
interface Props {
	stages: Stage[];
	sentences: Sentence[];
}

const { stages, sentences } = Astro.props;
const isDe = Astro.currentLocale === 'de';
const t = isDe
	? { sentence: 'Satz', stage: 'Stufe', choose: 'Testsatz auswählen' }
	: { sentence: 'Sentence', stage: 'Stage', choose: 'Choose a test sentence' };
const first = sentences[0];
const src = (stage: string, sentence: string) => `/audio/voice-ml/${stage}_${sentence}.mp3`;
---

<section class="voice-progress not-content" data-voice-progress>
	<div class="vp-tabs" role="group" aria-label={t.choose}>
		{sentences.map((s, i) => (
			<button type="button" class="vp-tab" data-sentence={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
				{s.label}
			</button>
		))}
	</div>

	{sentences.map((s, i) => (
		<div class="vp-sentence" data-sentence-text={s.id} hidden={i !== 0}>
			<p class="vp-hanzi" lang="zh-CN">{s.hanzi}</p>
			<p class="vp-pinyin" lang="zh-Latn-pinyin">{s.pinyin}</p>
			<p class="vp-translation">{s.translation}</p>
		</div>
	))}

	<ol class="vp-stages">
		{stages.map((stage, i) => (
			<li class:list={['vp-stage', { current: i === stages.length - 1 }]}>
				<div class="vp-stage-head">
					<span class="vp-step" aria-hidden="true">{i + 1}</span>
					<div>
						<p class="vp-label">{stage.label}</p>
						<p class="vp-model"><code>{stage.model}</code></p>
					</div>
				</div>
				<p class="vp-desc">{stage.description}</p>
				<audio controls preload="none" data-stage={stage.id} src={src(stage.id, first.id)}>
					<a href={src(stage.id, first.id)}>{stage.label} (MP3)</a>
				</audio>
			</li>
		))}
	</ol>
</section>

<style>
	.voice-progress {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background-color: color-mix(in srgb, var(--sl-color-bg) 85%, transparent);
		backdrop-filter: blur(6px);
	}
	.vp-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.vp-tab {
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.vp-tab[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	:global([data-theme='light']) .vp-tab[aria-pressed='true'] {
		color: #ffffff;
	}
	.vp-tab:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.vp-sentence p {
		margin: 0;
	}
	.vp-hanzi {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
		line-height: 1.4;
	}
	.vp-pinyin {
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
	}
	.vp-translation {
		margin-top: 0.25rem !important;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-style: italic;
	}
	.vp-stages {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.vp-stage {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background-color: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
	}
	.vp-stage.current {
		border-color: var(--sl-color-accent);
	}
	.vp-stage-head {
		display: flex;
		gap: 0.6rem;
		align-items: center;
	}
	.vp-step {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		background-color: var(--sl-color-gray-5);
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		font-weight: 700;
	}
	.vp-stage.current .vp-step {
		background-color: var(--sl-color-accent);
		color: #ffffff;
	}
	.vp-label,
	.vp-model,
	.vp-desc {
		margin: 0;
	}
	.vp-label {
		color: var(--sl-color-white);
		font-weight: 700;
		line-height: 1.3;
	}
	.vp-model code {
		font-size: var(--sl-text-xs);
	}
	.vp-desc {
		flex: 1;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	audio {
		width: 100%;
		height: 2.5rem;
	}
</style>

<script>
	function setupVoiceProgress(root: HTMLElement) {
		const tabs = root.querySelectorAll<HTMLButtonElement>('.vp-tab');
		const texts = root.querySelectorAll<HTMLElement>('[data-sentence-text]');
		const players = root.querySelectorAll<HTMLAudioElement>('audio[data-stage]');

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const id = tab.dataset.sentence!;
				tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
				texts.forEach((el) => (el.hidden = el.dataset.sentenceText !== id));
				players.forEach((audio) => {
					audio.pause();
					audio.src = `/audio/voice-ml/${audio.dataset.stage}_${id}.mp3`;
					const fallback = audio.querySelector('a');
					if (fallback) fallback.href = audio.src;
				});
			});
		});

		// Only one stage plays at a time, so comparing back and forth is easy.
		players.forEach((audio) => {
			audio.addEventListener('play', () => {
				players.forEach((other) => other !== audio && other.pause());
			});
		});
	}

	document.querySelectorAll<HTMLElement>('[data-voice-progress]').forEach(setupVoiceProgress);
</script>
