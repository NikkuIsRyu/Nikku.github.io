---
import type { RmiQuizItem } from '../../data/rmiData';
import { renderMathInText } from './katexHelper';

interface Props {
  item: RmiQuizItem;
  lang?: 'en' | 'de';
}

const { item, lang = 'en' } = Astro.props;
---

<div class="rmi-quiz-card not-content" id={`quiz-${item.id}`} data-quiz-id={item.id} data-correct-id={item.correctOptionId}>
  <!-- Card Header -->
  <header class="quiz-card-header">
    <div class="header-meta">
      <span class="quiz-badge">Q{item.number}</span>
      <span class="lesson-tag">{item.lesson}</span>
      <span class="timer-tag">⏱️ {item.timeLimitSec}s {lang === 'de' ? 'Zielzeit' : 'Target'}</span>
    </div>
    <h3 class="quiz-title">{item.title}</h3>
  </header>

  <!-- Question Prompt -->
  <div class="quiz-question-box">
    <p class="question-text" set:html={renderMathInText(item.question)} />
  </div>

  <!-- Interactive Options List -->
  <div class="quiz-options-group" role="radiogroup" aria-label={`Question ${item.number} options`}>
    {item.options.map((opt) => (
      <button
        type="button"
        class="quiz-option-btn"
        data-option-id={opt.id}
        aria-checked="false"
      >
        <span class="option-letter">{opt.id.toUpperCase()}</span>
        <span class="option-text" set:html={renderMathInText(opt.text)} />
        <span class="option-feedback-icon" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <!-- Control & Toggle Actions -->
  <div class="quiz-actions-row">
    <button type="button" class="btn-toggle-solution" data-expanded="false">
      <span class="solution-btn-icon">💡</span>
      <span class="solution-btn-text">{lang === 'de' ? 'Musterlösung einblenden' : 'Reveal Worked Solution'}</span>
    </button>
    <button type="button" class="btn-reset-quiz" title={lang === 'de' ? 'Zurücksetzen' : 'Reset Question'}>
      <span>🔄</span>
    </button>
  </div>

  <!-- Worked Solution & Distractor Breakdown Box -->
  <div class="solution-box" style="display: none;">
    <div class="solution-banner">
      <span class="solution-status-icon">✓</span>
      <span class="solution-status-title">
        {lang === 'de' ? `Richtige Antwort: Option (${item.correctOptionId.toUpperCase()})` : `Correct Choice: Option (${item.correctOptionId.toUpperCase()})`}
      </span>
    </div>

    <div class="solution-explanation">
      <h4 class="explanation-heading">{lang === 'de' ? 'Ausführliche Herleitung:' : 'Step-by-Step Derivation:'}</h4>
      <p class="explanation-text" set:html={renderMathInText(item.explanation)} />
    </div>

    <!-- Distractors Analysis -->
    <div class="distractor-section">
      <h4 class="distractor-heading">{lang === 'de' ? 'Warum die anderen Optionen falsch sind:' : 'Why Distractors Fail:'}</h4>
      <ul class="distractor-list">
        {item.distractorBreakdown.map((d) => (
          <li>
            <span class="distractor-id">({d.optionId.toUpperCase()}):</span>
            <span class="distractor-why" set:html={renderMathInText(d.whyWrong)} />
          </li>
        ))}
      </ul>
    </div>

    <!-- Slide & Literature Citation Footer -->
    <div class="citation-footer">
      <span class="citation-tag">📖 {item.slideRef}</span>
      <span class="citation-tag">📚 {item.bookRef}</span>
    </div>
  </div>
</div>

<script>
  function setupRmiQuizCards() {
    const cards = document.querySelectorAll<HTMLElement>('.rmi-quiz-card');

    cards.forEach((card) => {
      const correctId = card.dataset.correctId;
      const optionButtons = card.querySelectorAll<HTMLButtonElement>('.quiz-option-btn');
      const btnToggle = card.querySelector<HTMLButtonElement>('.btn-toggle-solution');
      const btnReset = card.querySelector<HTMLButtonElement>('.btn-reset-quiz');
      const solutionBox = card.querySelector<HTMLElement>('.solution-box');

      function selectOption(selectedBtn: HTMLButtonElement) {
        const selectedId = selectedBtn.dataset.optionId;
        const isCorrect = selectedId === correctId;

        // Reset all buttons in this card first
        optionButtons.forEach((b) => {
          b.classList.remove('selected', 'state-correct', 'state-wrong');
          b.setAttribute('aria-checked', 'false');
          const icon = b.querySelector('.option-feedback-icon');
          if (icon) icon.textContent = '';
        });

        // Apply state to selected button
        selectedBtn.classList.add('selected');
        selectedBtn.setAttribute('aria-checked', 'true');

        if (isCorrect) {
          selectedBtn.classList.add('state-correct');
          const icon = selectedBtn.querySelector('.option-feedback-icon');
          if (icon) icon.textContent = '✅';
        } else {
          selectedBtn.classList.add('state-wrong');
          const icon = selectedBtn.querySelector('.option-feedback-icon');
          if (icon) icon.textContent = '❌';

          // Also highlight the actual correct one for learning
          optionButtons.forEach((b) => {
            if (b.dataset.optionId === correctId) {
              b.classList.add('state-correct');
              const correctIcon = b.querySelector('.option-feedback-icon');
              if (correctIcon) correctIcon.textContent = '✅';
            }
          });
        }

        // Automatically expand the solution box
        if (solutionBox) {
          solutionBox.style.display = 'flex';
          if (btnToggle) {
            btnToggle.dataset.expanded = 'true';
            const textSpan = btnToggle.querySelector('.solution-btn-text');
            if (textSpan) textSpan.textContent = 'Musterlösung verbergen';
          }
        }
      }

      optionButtons.forEach((btn) => {
        btn.addEventListener('click', () => selectOption(btn));
      });

      if (btnToggle && solutionBox) {
        btnToggle.addEventListener('click', () => {
          const isExpanded = btnToggle.dataset.expanded === 'true';
          solutionBox.style.display = isExpanded ? 'none' : 'flex';
          btnToggle.dataset.expanded = (!isExpanded).toString();
          const textSpan = btnToggle.querySelector('.solution-btn-text');
          if (textSpan) {
            textSpan.textContent = isExpanded ? 'Musterlösung einblenden' : 'Musterlösung verbergen';
          }
        });
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          optionButtons.forEach((b) => {
            b.classList.remove('selected', 'state-correct', 'state-wrong');
            b.setAttribute('aria-checked', 'false');
            const icon = b.querySelector('.option-feedback-icon');
            if (icon) icon.textContent = '';
          });
          if (solutionBox) solutionBox.style.display = 'none';
          if (btnToggle) {
            btnToggle.dataset.expanded = 'false';
            const textSpan = btnToggle.querySelector('.solution-btn-text');
            if (textSpan) textSpan.textContent = 'Musterlösung einblenden';
          }
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupRmiQuizCards);
  document.addEventListener('astro:page-load', setupRmiQuizCards);
</script>

<style>
  .rmi-quiz-card {
    background: var(--sl-color-gray-6, #111827);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 16px;
    padding: 1.35rem;
    margin: 1.5rem 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.22);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }

  :global([data-theme='light']) .rmi-quiz-card {
    background: #ffffff;
    border-color: rgba(59, 130, 246, 0.28);
    box-shadow: 0 4px 18px rgba(59, 130, 246, 0.08);
  }

  .quiz-card-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global([data-theme='light']) .quiz-card-header {
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .quiz-badge {
    background: #2563eb;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
  }

  .lesson-tag {
    background: rgba(255, 255, 255, 0.06);
    color: var(--sl-color-gray-2);
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global([data-theme='light']) .lesson-tag {
    background: #f1f5f9;
    color: #475569;
    border-color: #cbd5e1;
  }

  .timer-tag {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  :global([data-theme='light']) .timer-tag {
    background: #fef3c7;
    color: #b45309;
    border-color: #fde68a;
  }

  .quiz-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.35;
  }

  :global([data-theme='light']) .quiz-title {
    color: #0f172a;
  }

  .quiz-question-box {
    background: rgba(0, 0, 0, 0.25);
    border-left: 3px solid #3b82f6;
    border-radius: 0 8px 8px 0;
    padding: 0.75rem 1rem;
  }

  :global([data-theme='light']) .quiz-question-box {
    background: #f8fafc;
    border-left-color: #2563eb;
  }

  .question-text {
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--sl-color-gray-1);
    margin: 0;
    font-weight: 500;
  }

  :global([data-theme='light']) .question-text {
    color: #1e293b;
  }

  /* Options */
  .quiz-options-group {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .quiz-option-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 0.65rem 0.95rem;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
    transition: all 0.18s ease;
    box-sizing: border-box;
    width: 100%;
  }

  :global([data-theme='light']) .quiz-option-btn {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #334155;
  }

  .quiz-option-btn:hover {
    background: rgba(30, 41, 59, 0.8);
    border-color: #3b82f6;
    color: var(--sl-color-white);
  }

  :global([data-theme='light']) .quiz-option-btn:hover {
    background: #eff6ff;
    border-color: #2563eb;
    color: #0f172a;
  }

  .option-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    font-weight: 700;
    font-size: 0.75rem;
    flex-shrink: 0;
    color: var(--sl-color-gray-2);
  }

  :global([data-theme='light']) .option-letter {
    background: #e2e8f0;
    color: #475569;
  }

  .option-text {
    flex-grow: 1;
    word-break: break-word;
  }

  .option-feedback-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* Option States */
  .quiz-option-btn.state-correct {
    background: rgba(16, 185, 129, 0.15) !important;
    border-color: #10b981 !important;
    color: #6ee7b7 !important;
  }

  :global([data-theme='light']) .quiz-option-btn.state-correct {
    background: #ecfdf5 !important;
    border-color: #10b981 !important;
    color: #065f46 !important;
  }

  .quiz-option-btn.state-correct .option-letter {
    background: #10b981;
    color: #ffffff;
  }

  .quiz-option-btn.state-wrong {
    background: rgba(239, 68, 68, 0.15) !important;
    border-color: #ef4444 !important;
    color: #fca5a5 !important;
  }

  :global([data-theme='light']) .quiz-option-btn.state-wrong {
    background: #fef2f2 !important;
    border-color: #ef4444 !important;
    color: #991b1b !important;
  }

  .quiz-option-btn.state-wrong .option-letter {
    background: #ef4444;
    color: #ffffff;
  }

  /* Actions */
  .quiz-actions-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding-top: 0.25rem;
  }

  .btn-toggle-solution {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.35rem 0.85rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #60a5fa;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  :global([data-theme='light']) .btn-toggle-solution {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #2563eb;
  }

  .btn-toggle-solution:hover {
    background: rgba(59, 130, 246, 0.22);
    border-color: #3b82f6;
  }

  .btn-reset-quiz {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.18s ease;
  }

  :global([data-theme='light']) .btn-reset-quiz {
    background: #f1f5f9;
    border-color: #e2e8f0;
  }

  .btn-reset-quiz:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: rotate(45deg);
  }

  /* Solution Box */
  .solution-box {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 12px;
    padding: 1rem;
    animation: rmi-fade-in 0.25s ease-out;
  }

  :global([data-theme='light']) .solution-box {
    background: #ecfdf5;
    border-color: #a7f3d0;
  }

  @keyframes rmi-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .solution-banner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #34d399;
    font-weight: 700;
    font-size: 0.875rem;
  }

  :global([data-theme='light']) .solution-banner {
    color: #059669;
  }

  .solution-explanation {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .explanation-heading, .distractor-heading {
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  :global([data-theme='light']) .explanation-heading,
  :global([data-theme='light']) .distractor-heading {
    color: #1e293b;
  }

  .explanation-text {
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  :global([data-theme='light']) .explanation-text {
    color: #334155;
  }

  .distractor-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .distractor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .distractor-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.775rem;
    line-height: 1.4;
  }

  .distractor-id {
    font-weight: 700;
    color: #f87171;
    flex-shrink: 0;
  }

  :global([data-theme='light']) .distractor-id {
    color: #dc2626;
  }

  .distractor-why {
    color: var(--sl-color-gray-3);
  }

  :global([data-theme='light']) .distractor-why {
    color: #475569;
  }

  .citation-footer {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    padding-top: 0.65rem;
    font-size: 0.725rem;
    color: var(--sl-color-gray-3);
  }

  :global([data-theme='light']) .citation-footer {
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  .citation-tag {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  :global([data-theme='light']) .citation-tag {
    background: #ffffff;
    border-color: #e2e8f0;
  }
</style>
