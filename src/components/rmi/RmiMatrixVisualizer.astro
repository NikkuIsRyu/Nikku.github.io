    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;

    // Rotation Mode State (Euler Angles in Degrees)
    let rollDeg = 0;
    let pitchDeg = 0;
    let yawDeg = 0;
    let rotOrder = 'fixed'; // 'fixed' | 'body'
    let activeCustomMatrix = null; // null | number[3][3]

    // Robot Arm Joint Angles (in Degrees)
    const armAngles = {
      ar4: [0, 0, 0, 0, 0, 0],
      planar2r: [0, 0],
      spatial3r: [0, 0, 0]
    };

    // Model Specifications
    const ROBOT_SPECS = {
      ar4: {
        name: 'Annin AR4 (6-DoF)',
        dof: 6,
        joints: [
          { name: 'J1 (Base Swivel)', axis: [0, 0, 1], min: -170, max: 170, q: [0, 0, 0] },
          { name: 'J2 (Shoulder)',    axis: [0, 1, 0], min: -42,  max: 90,  q: [64.2, 0, 169.8] },
          { name: 'J3 (Elbow)',       axis: [0, 1, 0], min: -89,  max: 52,  q: [64.2, 0, 474.8] },
          { name: 'J4 (Forearm Roll)',axis: [1, 0, 0], min: -165, max: 165, q: [0, 0, 474.8] },
          { name: 'J5 (Wrist Pitch)', axis: [0, 1, 0], min: -105, max: 105, q: [286.8, 0, 474.8] },
          { name: 'J6 (Flange Roll)', axis: [1, 0, 0], min: -180, max: 180, q: [0, 0, 474.8] }
        ],
        // Dimensions in mm
        d1: 169.8, a1: 64.2, a2: 305.0, d4: 222.6, d6: 41.0,
        homePoseM: [
          [0, 0, 1, 327.8],
