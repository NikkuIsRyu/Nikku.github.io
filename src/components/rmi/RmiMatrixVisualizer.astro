---
/**
 * RmiMatrixVisualizer.astro
 * Interactive 3D Graphical Kinematics Studio & Matrix Learning Lab
 * Robotics & Machine Intelligence (RMI) · Heidelberg University
 * 
 * Features:
 * 1. 3D SO(3) Rotation Matrix Visualizer with color-coded column vectors, Euler angles & Gimbal Lock demo.
 * 2. 6-DoF AR4 / 2R / 3R Articulated Robot Arm with real-time Product of Exponentials (PoE) & Screw Axes.
 * 3. Matrix Operator Sandbox: Skew-symmetric bracket [w], Rodrigues expansion, and SE(3) Inverses.
 */

interface Props {
  lang?: 'en' | 'de';
}

const { lang = 'en' } = Astro.props;
---

<div class="rmi-visualizer-card not-content" id="rmi-visualizer-root">
  <!-- Visualizer Header -->
  <div class="vis-header">
    <div class="vis-title-group">
      <span class="vis-badge">🕹️ {lang === 'de' ? 'Interaktives Kinematik-Labor' : 'Interactive Kinematics Lab'}</span>
      <h3 class="vis-title">
        {lang === 'de' ? '3D Matrix- & Roboterarm-Visualisierer' : '3D Matrix & Robot Arm Kinematics Studio'}
      </h3>
      <p class="vis-subtitle">
        {lang === 'de' 
          ? 'Visuelle Geometrie statt reiner Theorie: Verstehe Drehmatrizen SO(3), Freiheitsgrade (DoF), Schraubenachsen & Product of Exponentials (PoE) in Echtzeit.' 
          : 'Visual geometry beyond theory: Experience SO(3) rotation matrices, Degrees of Freedom (DoF), Screw Axes, and Product of Exponentials (PoE) in real time.'}
      </p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="vis-tabs" role="tablist">
      <button type="button" class="vis-tab active" data-tab="rotation" role="tab" aria-selected="true">
        <span class="tab-icon">🔄</span>
        <span class="tab-text">{lang === 'de' ? 'SO(3) Drehmatrix & 3D-Frame' : 'SO(3) Rotation Matrix & Frame'}</span>
      </button>
      <button type="button" class="vis-tab" data-tab="robotarm" role="tab" aria-selected="false">
        <span class="tab-icon">🦾</span>
        <span class="tab-text">{lang === 'de' ? 'Roboterarm & PoE Kinematik' : 'Robot Arm & PoE Kinematics'}</span>
      </button>
      <button type="button" class="vis-tab" data-tab="matrixlab" role="tab" aria-selected="false">
        <span class="tab-icon">📐</span>
        <span class="tab-text">{lang === 'de' ? 'Matrix-Labor & Operatoren' : 'Matrix Lab & Operators'}</span>
      </button>
    </div>
  </div>

  <!-- MAIN WORKSPACE -->
  <div class="vis-workspace">
    <!-- LEFT: 3D INTERACTIVE CANVAS VIEWPORT -->
    <div class="vis-canvas-container">
      <canvas id="rmi-viewport-canvas" width="640" height="480"></canvas>
      
      <!-- Overlay Canvas Controls -->
      <div class="canvas-overlay-top">
        <span class="canvas-tag" id="canvas-active-mode-label">SO(3) Frame View</span>
        <span class="canvas-hint">🖱️ {lang === 'de' ? 'Ziehen: Drehen · Rad: Zoom' : 'Drag: Orbit · Scroll: Zoom'}</span>
      </div>

      <div class="canvas-overlay-bottom">
        <button type="button" class="btn-canvas-action" id="btn-reset-camera" title="Reset View">
          ↺ {lang === 'de' ? 'Kamera Reset' : 'Reset Camera'}
        </button>
        <button type="button" class="btn-canvas-action" id="btn-toggle-grid" title="Toggle Ground Grid">
          ▦ {lang === 'de' ? 'Gitter an/aus' : 'Toggle Grid'}
        </button>
        <button type="button" class="btn-canvas-action" id="btn-toggle-screws" title="Toggle Screw Axes" style="display: none;">
          ⚡ {lang === 'de' ? 'Schraubenachsen' : 'Screw Axes'}
        </button>
      </div>

      <!-- Gimbal Lock Alert Banner -->
      <div class="gimbal-lock-alert" id="gimbal-lock-banner" style="display: none;">
        <span class="alert-icon">⚠️</span>
        <div class="alert-text">
          <strong>{lang === 'de' ? 'Gimbal Lock (Singularität) erreicht!' : 'Gimbal Lock (Singularity) Reached!'}</strong>
          <span>{lang === 'de' ? 'Pitch = ±90°: Roll- und Yaw-Achsen fallen zusammen. 1 DoF geht verloren!' : 'Pitch = ±90°: Roll and Yaw axes align. 1 DoF is lost!'}</span>
        </div>
      </div>
    </div>

    <!-- RIGHT: DYNAMIC CONTROLS & LIVE MATRIX READOUT -->
    <div class="vis-control-panel">
      <!-- PANEL 1: SO(3) ROTATION MATRIX CONTROLS -->
      <div class="panel-section active" id="sec-rotation-controls">
        <div class="section-badge-row">
          <span class="ctrl-subbadge">SO(3) Lie Group</span>
          <span class="ctrl-ortho-tag" id="ortho-status-tag">Orthogonal ✓</span>
        </div>

        <h4 class="ctrl-heading">{lang === 'de' ? 'Drehachsen & Euler-Winkel' : 'Rotation Angles & Orientation'}</h4>
        
        <!-- Euler Angle Sliders -->
        <div class="slider-group">
          <div class="slider-row">
            <div class="slider-header">
              <span class="axis-pill axis-x">Roll (X) · φ</span>
              <span class="slider-val" id="val-roll">0°</span>
            </div>
            <input type="range" id="slider-roll" min="-180" max="180" value="0" step="1" class="custom-range" />
          </div>

          <div class="slider-row">
            <div class="slider-header">
              <span class="axis-pill axis-y">Pitch (Y) · θ</span>
              <span class="slider-val" id="val-pitch">0°</span>
            </div>
            <input type="range" id="slider-pitch" min="-180" max="180" value="0" step="1" class="custom-range" />
          </div>

          <div class="slider-row">
            <div class="slider-header">
              <span class="axis-pill axis-z">Yaw (Z) · ψ</span>
              <span class="slider-val" id="val-yaw">0°</span>
            </div>
            <input type="range" id="slider-yaw" min="-180" max="180" value="0" step="1" class="custom-range" />
          </div>
        </div>

        <!-- Quick Presets -->
        <div class="quick-presets">
          <span class="preset-label">{lang === 'de' ? 'Presets:' : 'Presets:'}</span>
          <button type="button" class="btn-preset" id="preset-rot-zero">Zero (Identity)</button>
          <button type="button" class="btn-preset" id="preset-rot-gimbal">Pitch 90° (Gimbal Lock)</button>
          <button type="button" class="btn-preset" id="preset-rot-x90">X +90°</button>
          <button type="button" class="btn-preset" id="preset-rot-z90">Z +90°</button>
        </div>

        <!-- Live Color-Coded Rotation Matrix with Bidirectional Input -->
        <div class="matrix-card">
          <div class="matrix-card-header">
            <div class="mat-header-left">
              <span class="mat-title">Rotation Matrix R ∈ SO(3)</span>
              <span class="mat-edit-badge" id="mat-interactive-badge">✍️ {lang === 'de' ? 'Interaktiv editierbar' : 'Directly Editable'}</span>
            </div>
            <span class="mat-rule-hint">💡 {lang === 'de' ? 'Spalten = Einheitsvektoren!' : 'Columns = Basis Vectors!'}</span>
          </div>

          <p class="matrix-input-hint">
            {lang === 'de'
              ? 'Tippe Werte direkt in die Matrixzellen ein oder wähle eine Vorlesungsmatrix: Eulerwinkel & 3D-Frame passen sich automatisch an!'
              : 'Type values directly into matrix cells or pick a lecture preset: Euler angles & 3D frame update in real time!'}
          </p>

          <div class="matrix-grid-3x3" id="mat-so3-grid">
            <!-- Row 1 -->
            <input type="number" step="0.05" class="mat-cell-input col-x" id="m00" value="1.00" title="R[0,0] (Col 1: x_b)" />
            <input type="number" step="0.05" class="mat-cell-input col-y" id="m01" value="0.00" title="R[0,1] (Col 2: y_b)" />
            <input type="number" step="0.05" class="mat-cell-input col-z" id="m02" value="0.00" title="R[0,2] (Col 3: z_b)" />
            <!-- Row 2 -->
            <input type="number" step="0.05" class="mat-cell-input col-x" id="m10" value="0.00" title="R[1,0] (Col 1: x_b)" />
            <input type="number" step="0.05" class="mat-cell-input col-y" id="m11" value="1.00" title="R[1,1] (Col 2: y_b)" />
            <input type="number" step="0.05" class="mat-cell-input col-z" id="m12" value="0.00" title="R[1,2] (Col 3: z_b)" />
            <!-- Row 3 -->
            <input type="number" step="0.05" class="mat-cell-input col-x" id="m20" value="0.00" title="R[2,0] (Col 1: x_b)" />
            <input type="number" step="0.05" class="mat-cell-input col-y" id="m21" value="0.00" title="R[2,1] (Col 2: y_b)" />
            <input type="number" step="0.05" class="mat-cell-input col-z" id="m22" value="1.00" title="R[2,2] (Col 3: z_b)" />
          </div>

          <div class="matrix-actions-strip">
            <button type="button" class="btn-mat-action btn-proj" id="btn-ortho-proj" title="Orthonormalize columns via Gram-Schmidt">
              ⚡ {lang === 'de' ? 'Auf SO(3) projizieren' : 'Orthonormalize SO(3)'}
            </button>
            <button type="button" class="btn-mat-action btn-reset" id="btn-matrix-identity" title="Reset to Identity matrix">
              ↺ {lang === 'de' ? 'Identität I' : 'Identity I'}
            </button>
          </div>

          <div class="matrix-legend">
            <span class="leg-item leg-x">● Col 1: x̂_b (Red)</span>
            <span class="leg-item leg-y">● Col 2: ŷ_b (Green)</span>
            <span class="leg-item leg-z">● Col 3: ẑ_b (Blue)</span>
          </div>

          <!-- Presets from Heidelberg Lectures -->
          <div class="lecture-matrix-presets">
            <span class="lecture-presets-title">📚 {lang === 'de' ? 'Matrizen aus den Vorlesungsfolien:' : 'Lecture Slide Matrices:'}</span>
            <div class="lecture-presets-grid">
              <button type="button" class="btn-lecture-mat" id="mat-preset-rz90" title="Rot(z, 90°): x_b points to y_s">
                <strong>Rot(z, 90°)</strong>
                <code>[0,-1,0; 1,0,0; 0,0,1]</code>
              </button>
              <button type="button" class="btn-lecture-mat" id="mat-preset-ry90" title="Rot(y, 90°): z_b points to x_s">
                <strong>Rot(y, 90°)</strong>
                <code>[0,0,1; 0,1,0; -1,0,0]</code>
              </button>
              <button type="button" class="btn-lecture-mat" id="mat-preset-rx180" title="Rot(x, 180°): Upside down about x">
                <strong>Rot(x, 180°)</strong>
                <code>[1,0,0; 0,-1,0; 0,0,-1]</code>
              </button>
              <button type="button" class="btn-lecture-mat" id="mat-preset-down" title="AR4 Gripper pointing straight down">
                <strong>AR4 Gripper Down</strong>
                <code>[-1,0,0; 0,1,0; 0,0,-1]</code>
              </button>
              <button type="button" class="btn-lecture-mat" id="mat-preset-ar4-l2" title="AR4 Tool Rot(z, 90)*Rot(y, 90)">
                <strong>AR4 Tool Turn (L2)</strong>
                <code>[0,0,-1; -1,0,0; 0,1,0]</code>
              </button>
              <button type="button" class="btn-lecture-mat btn-warn-mat" id="mat-preset-mirror" title="Reflection test (det = -1, not in SO(3))">
                <strong>Reflection (det = -1)</strong>
                <code>[1,0,0; 0,1,0; 0,0,-1]</code>
              </button>
            </div>
          </div>

          <div class="matrix-metrics">
            <div class="metric-pill">
              <span class="metric-k">det(R):</span>
              <span class="metric-v" id="val-det">1.000</span>
            </div>
            <div class="metric-pill">
              <span class="metric-k">tr(R):</span>
              <span class="metric-v" id="val-trace">3.000</span>
            </div>
            <div class="metric-pill">
              <span class="metric-k">Angle θ:</span>
              <span class="metric-v" id="val-axis-angle">0.0°</span>
            </div>
          </div>
        </div>

        <!-- Rotation Order Toggle -->
        <div class="order-toggle-box">
          <span class="order-title">⚙️ {lang === 'de' ? 'Rotationsreihenfolge:' : 'Order of Rotations:'}</span>
          <div class="order-options">
            <label class="radio-label">
              <input type="radio" name="rot-order" value="fixed" checked />
              <span>{lang === 'de' ? 'Fester Raum-Frame (Links-Multiplikation)' : 'Fixed Space Frame (Pre-multiplication)'}</span>
            </label>
            <label class="radio-label">
              <input type="radio" name="rot-order" value="body" />
              <span>{lang === 'de' ? 'Bewegter Körper-Frame (Rechts-Multiplikation)' : 'Moving Body Frame (Post-multiplication)'}</span>
            </label>
          </div>
        </div>
      </div>

      <!-- PANEL 2: ROBOT ARM & POE CONTROLS -->
      <div class="panel-section" id="sec-robotarm-controls" style="display: none;">
        <div class="section-badge-row">
          <span class="ctrl-subbadge">Forward Kinematics (FK)</span>
          <span class="ctrl-ortho-tag" id="arm-dof-badge">6-DoF Arm</span>
        </div>

        <div class="robot-model-selector">
          <label class="selector-label">{lang === 'de' ? 'Roboter-Modell:' : 'Robot Model:'}</label>
          <div class="model-buttons">
            <button type="button" class="btn-model active" data-model="ar4">Annin AR4 (6-DoF)</button>
            <button type="button" class="btn-model" data-model="planar2r">2R Planar (2-DoF)</button>
            <button type="button" class="btn-model" data-model="spatial3r">3R Spatial (3-DoF)</button>
          </div>
        </div>

        <!-- Joint Sliders (Dynamically Populated) -->
        <div class="joint-sliders-container" id="joint-sliders-list">
          <!-- Injected via JavaScript based on selected robot -->
        </div>

        <!-- Robot Presets -->
        <div class="quick-presets">
          <span class="preset-label">{lang === 'de' ? 'Posen:' : 'Poses:'}</span>
          <button type="button" class="btn-preset" id="preset-arm-home">Home Pose (M)</button>
          <button type="button" class="btn-preset" id="preset-arm-down">Lecture 3: Pointing Down</button>
          <button type="button" class="btn-preset" id="preset-arm-reach">Reach Limit</button>
        </div>

        <!-- Live SE(3) End-Effector Pose Readout -->
        <div class="matrix-card">
          <div class="matrix-card-header">
            <span class="mat-title">End-Effector Pose T(θ) = e^[S1]θ1 ··· M ∈ SE(3)</span>
          </div>

          <div class="matrix-grid-4x4" id="mat-se3-grid">
            <!-- 4x4 Homogeneous Transform Matrix -->
          </div>

          <div class="end-effector-summary">
            <div class="ee-pos-box">
              <span class="ee-label">{lang === 'de' ? 'Position (x, y, z) in mm:' : 'Tip Position (x, y, z) mm:'}</span>
              <span class="ee-val" id="ee-pos-val">x: 327.8, y: 0.0, z: 474.8</span>
            </div>
            <div class="ee-pos-box">
              <span class="ee-label">{lang === 'de' ? 'DoF & Gruebler Mobilität:' : 'DoF & Grübler Mobility:'}</span>
              <span class="ee-val text-accent" id="ee-dof-val">m = 6(7 - 1 - 6) + 6 = 6 DoF</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL 3: MATRIX LAB & OPERATORS -->
      <div class="panel-section" id="sec-matrixlab-controls" style="display: none;">
        <div class="section-badge-row">
          <span class="ctrl-subbadge">Lie Algebra so(3) & SE(3)</span>
          <span class="ctrl-ortho-tag">Interactive Sandbox</span>
        </div>

        <h4 class="ctrl-heading">{lang === 'de' ? 'Matrix-Operatoren testen' : 'Matrix Operator Playground'}</h4>

        <!-- Operator 1: Skew-Symmetric Bracket [w] -->
        <div class="lab-operator-box">
          <div class="op-header">
            <span class="op-num">1</span>
            <div class="op-title-wrap">
              <span class="op-title">Skew-Symmetric Bracket [ω] ∈ so(3)</span>
              <span class="op-desc">{lang === 'de' ? 'Kreuzprodukt als Matrixmultiplikation: [ω]v = ω × v' : 'Cross product as matrix multiplication: [ω]v = ω × v'}</span>
            </div>
          </div>
          <div class="vector-inputs">
            <label>ωx: <input type="number" id="lab-wx" value="0" step="0.1" class="num-input" /></label>
            <label>ωy: <input type="number" id="lab-wy" value="0" step="0.1" class="num-input" /></label>
            <label>ωz: <input type="number" id="lab-wz" value="1" step="0.1" class="num-input" /></label>
          </div>
          <div class="lab-output-bracket" id="bracket-output-grid">
            <!-- Skew matrix grid -->
          </div>
          <div class="op-property-check" id="bracket-prop-check">
            ✓ [ω]^T = -[ω] (Skew-Symmetric) | [ω]^3 = -[ω] (Unit Axis)
          </div>
        </div>

        <!-- Operator 2: Rodrigues Matrix Exponential -->
        <div class="lab-operator-box">
          <div class="op-header">
            <span class="op-num">2</span>
            <div class="op-title-wrap">
              <span class="op-title">Rodrigues Formula: e^[ω̂]θ = I + sin θ [ω̂] + (1-cos θ)[ω̂]²</span>
              <span class="op-desc">{lang === 'de' ? 'Drehung um beliebige Einheitsachse' : 'Analytical rotation around arbitrary unit axis'}</span>
            </div>
          </div>
          <div class="angle-input-row">
            <label>{lang === 'de' ? 'Winkel θ:' : 'Angle θ:'}</label>
            <input type="range" id="lab-rodrigues-angle" min="-180" max="180" value="45" step="5" class="custom-range" />
            <span class="slider-val" id="lab-rodrigues-angle-val">45°</span>
          </div>
          <div class="rodrigues-breakdown" id="rodrigues-breakdown-result">
            <!-- Resulting SO(3) matrix -->
          </div>
        </div>

        <!-- Operator 3: SE(3) Inverse Inversion -->
        <div class="lab-operator-box">
          <div class="op-header">
            <span class="op-num">3</span>
            <div class="op-title-wrap">
              <span class="op-title">Homogeneous Inverse: T⁻¹ = [R^T, -R^T p; 0, 1]</span>
              <span class="op-desc">{lang === 'de' ? 'Warum -R^T p statt -p? Weil der Ursprung im neuen Frame gedreht wird!' : 'Why -R^T p instead of -p? Because the origin must be viewed in rotated coordinates!'}</span>
            </div>
          </div>
          <div class="se3-inv-display" id="se3-inv-explanation">
            <code>T_sb = [R, p; 0, 1] ⟹ T_bs = (T_sb)⁻¹ = [R^T, -R^T p; 0, 1]</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .rmi-visualizer-card {
    margin: 2rem 0;
    padding: 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(180deg, #161b22 0%, #0d1117 100%);
    border: 1px solid var(--sl-color-hairline, #30363d);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    color: var(--sl-color-white, #f0f6fc);
    font-family: inherit;
    box-sizing: border-box;
    overflow: hidden;
  }

  .vis-header {
    border-bottom: 1px solid #30363d;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .vis-title-group {
    margin-bottom: 1rem;
  }

  .vis-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .vis-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0.25rem 0;
    color: #fff;
  }

  .vis-subtitle {
    font-size: 0.9rem;
    color: #8b949e;
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }

  /* Mode Tabs */
  .vis-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .vis-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.5rem;
    background: #21262d;
    border: 1px solid #30363d;
    color: #c9d1d9;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .vis-tab:hover {
    background: #30363d;
    color: #fff;
  }

  .vis-tab.active {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #38bdf8;
  }

  /* Workspace Layout */
  .vis-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .vis-workspace {
      grid-template-columns: 1fr;
    }
  }

  /* 3D Canvas Viewport */
  .vis-canvas-container {
    position: relative;
    border-radius: 0.75rem;
    background: #090d13;
    border: 1px solid #30363d;
    overflow: hidden;
    height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
  }

  #rmi-viewport-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  #rmi-viewport-canvas:active {
    cursor: grabbing;
  }

  .canvas-overlay-top {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .canvas-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    background: rgba(22, 27, 34, 0.85);
    border: 1px solid #30363d;
    border-radius: 0.35rem;
    color: #58a6ff;
    backdrop-filter: blur(4px);
  }

  .canvas-hint {
    font-size: 0.75rem;
    color: #8b949e;
    background: rgba(22, 27, 34, 0.85);
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    border: 1px solid #30363d;
    backdrop-filter: blur(4px);
  }

  .canvas-overlay-bottom {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  .btn-canvas-action {
    background: rgba(22, 27, 34, 0.85);
    border: 1px solid #30363d;
    color: #c9d1d9;
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 0.35rem;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.15s ease;
  }

  .btn-canvas-action:hover {
    background: #30363d;
    color: #fff;
