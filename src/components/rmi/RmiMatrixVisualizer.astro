          { name: 'Joint 1 (Base)',  axis: [0, 0, 1], min: -180, max: 180, q: [0, 0, 0] },
          { name: 'Joint 2 (Elbow)', axis: [0, 0, 1], min: -150, max: 150, q: [200, 0, 0] }
        ],
