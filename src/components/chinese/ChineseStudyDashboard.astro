---
interface Props {
  activeSection?: 'dialogues' | 'grammar' | 'tones' | 'assets';
  lang?: 'de' | 'en';
}

const { activeSection = 'dialogues', lang = 'de' } = Astro.props;

const modes = [
  {
    id: 'dialogues',
    icon: '🎙️',
    labelDe: 'Multi-Speaker Audio-Dialoge',
    labelEn: 'Multi-Speaker Audio Dialogues',
    badge: '18 Dialoge',
    descDe: 'Lektionen 2–10 mit Dual-Speed (1.0x / 0.75x) & Satz-Looping',
    descEn: 'Lessons 2–10 with Dual-Speed (1.0x / 0.75x) & Shadowing Loop'
  },
  {
    id: 'grammar',
    icon: '📐',
    labelDe: 'Systematischer Grammatik-Explorer',
    labelEn: 'Systematic Grammar Explorer',
    badge: '26 Regeln + Confusables',
    descDe: 'Bento-Cards, Formel-Pills & Pinyin Active-Recall',
    descEn: 'Bento Cards, Formula Pills & Pinyin Active Recall'
  },
  {
    id: 'tones',
    icon: '🇨🇳',
    labelDe: 'Tonsystem & Tone Sandhi',
    labelEn: 'Tonal System & Tone Sandhi',
    badge: '4 Töne + Sandhi',
    descDe: 'Grundtöne, Neutralton & unverzichtbare Tonwechsel-Regeln',
    descEn: 'Basic Tones, Neutral Tone & Essential Tone Sandhi Rules'
  },
  {
    id: 'assets',
    icon: '🗂️',
    labelDe: 'Kurs-Assets, Anki & Voice-ML',
    labelEn: 'Course Assets, Anki & Voice-ML',
    badge: 'Downloads & Tech',
    descDe: '560-Noten Anki-Deck, JSON-Timestamps & Pipeline-Architektur',
    descEn: '560-Note Anki Deck, JSON Timestamps & Voice-ML Pipeline'
  }
];
---

<nav class="study-dashboard-nav not-content" aria-label="Lernbereich-Umschalter">
  <div class="nav-intro">
    <span class="mode-badge">⚡ Lernmodus-Dashboard (Study Mode Navigation)</span>
    <span class="mode-help">Wähle deinen aktuellen Fokusbereich:</span>
  </div>

  <div class="nav-grid">
    {modes.map((m) => (
      <a
        href={`#section-${m.id}`}
        class={`nav-card ${m.id === activeSection ? 'active' : ''}`}
        data-mode-id={m.id}
      >
        <div class="card-top">
          <span class="card-icon">{m.icon}</span>
          <span class="card-badge">{m.badge}</span>
        </div>
        <h4 class="card-title">{lang === 'en' ? m.labelEn : m.labelDe}</h4>
        <p class="card-desc">{lang === 'en' ? m.descEn : m.descDe}</p>
      </a>
    ))}
  </div>
</nav>

<script>
  function setupStudyDashboard() {
    const cards = document.querySelectorAll('.study-dashboard-nav .nav-card');
    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        cards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupStudyDashboard);
  document.addEventListener('astro:page-load', setupStudyDashboard);
</script>

<style>
  .study-dashboard-nav {
    display: flex;
    flex-direction: column;
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid var(--sl-color-gray-5, #232530);
    border-radius: 14px;
    padding: 1.25rem;
    gap: 0.9rem;
    margin: 1.5rem 0 2rem 0;
  }

  .nav-intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.6rem;
  }

  .mode-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--sl-color-accent-high, #818cf8);
    letter-spacing: 0.05em;
  }

  .mode-help {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3, #94a3b8);
  }

  .nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .nav-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .nav-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    background: var(--sl-color-gray-6, #15161b);
    border: 1px solid var(--sl-color-gray-5, #282a36);
    border-radius: 10px;
    padding: 1rem;
    text-decoration: none;
    gap: 0.4rem;
    transition: all 0.18s ease;
  }

  .nav-card:hover {
    border-color: var(--sl-color-accent, #6366f1);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.15);
  }

  .nav-card.active {
    background: rgba(99, 102, 241, 0.1);
    border-color: var(--sl-color-accent, #6366f1);
    box-shadow: 0 0 0 1px var(--sl-color-accent, #6366f1);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon {
    font-size: 1.4rem;
  }

  .card-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--sl-color-white, #f8fafc);
    margin: 0.15rem 0 0 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.76rem;
    color: var(--sl-color-gray-3, #94a3b8);
    margin: 0;
    line-height: 1.45;
  }
</style>
