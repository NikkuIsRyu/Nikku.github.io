---
interface Props {
  activeSection?: 'dialogues' | 'grammar' | 'tones' | 'vocab' | 'assets' | 'all';
  lang?: 'de' | 'en';
}

const { activeSection = 'dialogues', lang = 'de' } = Astro.props;

const modes = [
  {
    id: 'dialogues',
    icon: '🎙️',
    labelDe: 'Multi-Speaker Audio-Dialoge',
    labelEn: 'Multi-Speaker Audio Dialogues',
    badge: '18 Dialoge',
    descDe: 'Lektionen 2–10 mit Dual-Speed (1.0x / 0.75x) & Satz-Looping',
    descEn: 'Lessons 2–10 with Dual-Speed (1.0x / 0.75x) & Shadowing Loop'
  },
  {
    id: 'grammar',
    icon: '📐',
    labelDe: 'Systematischer Grammatik-Explorer',
    labelEn: 'Systematic Grammar Explorer',
    badge: '26 Regeln + Confusables',
    descDe: 'Bento-Cards, Formel-Pills & Pinyin Active-Recall',
    descEn: 'Bento Cards, Formula Pills & Pinyin Active Recall'
  },
  {
    id: 'vocab',
    icon: '🔤',
    labelDe: 'Vokabel-Lexikon & Vault',
    labelEn: 'Vocabulary Lexicon & Vault',
    badge: '579 Vokabeln',
    descDe: 'Lektionen 1–10 mit Pinyin-Hover-Recall & Strichfolge ✍️',
    descEn: 'Lessons 1–10 with Pinyin Hover Recall & Stroke Guide ✍️'
  },
  {
    id: 'tones',
    icon: '🇨🇳',
    labelDe: 'Tonsystem & Tone Sandhi',
    labelEn: 'Tonal System & Tone Sandhi',
    badge: '4 Töne + Sandhi',
    descDe: 'Grundtöne, Neutralton & unverzichtbare Tonwechsel-Regeln',
    descEn: 'Basic Tones, Neutral Tone & Essential Tone Sandhi Rules'
  },
  {
    id: 'assets',
    icon: '🗂️',
    labelDe: 'Kurs-Assets & Anki-Deck',
    labelEn: 'Course Assets & Anki Deck',
    badge: 'Downloads (WIP)',
    descDe: '560-Noten Anki-Deck & Master-Aufnahmen (Work In Progress)',
    descEn: '560-Note Anki Deck & Master Recordings (Work In Progress)'
  }
];
---

<nav class="study-dashboard-nav not-content" id="study-mode-dashboard-nav" aria-label="Lernbereich-Umschalter">
  <div class="nav-intro">
    <div class="nav-intro-left">
      <span class="live-pulse"></span>
      <span class="mode-badge">⚡ {lang === 'en' ? 'Study Mode Navigation' : 'Lernmodus-Dashboard'}</span>
    </div>
    <div class="nav-intro-right">
      <button type="button" class="btn-show-all-modes" id="btn-toggle-all-modes" data-active-all="false">
        <span class="btn-all-icon">🌐</span>
        <span class="btn-all-text">{lang === 'en' ? 'Show All Sections (Full Document)' : 'Alle Bereiche anzeigen (Vollansicht)'}</span>
      </button>
    </div>
  </div>

  <div class="nav-grid">
    {modes.map((m) => (
      <button
        type="button"
        class={`nav-card ${m.id === activeSection ? 'active' : ''}`}
        data-mode-id={m.id}
        title={lang === 'en' ? `Switch to ${m.labelEn}` : `Zu ${m.labelDe} wechseln`}
      >
        <div class="card-top">
          <span class="card-icon">{m.icon}</span>
          <span class="card-badge">{m.badge}</span>
        </div>
        <h4 class="card-title">{lang === 'en' ? m.labelEn : m.labelDe}</h4>
        <p class="card-desc">{lang === 'en' ? m.descEn : m.descDe}</p>
        <div class="active-indicator">
          <span>{lang === 'en' ? 'Active Focus Mode' : 'Aktiver Modus'}</span>
          <span class="indicator-arrow">→</span>
        </div>
      </button>
    ))}
  </div>

  <div class="mode-active-bar" id="mode-active-bar">
    <span class="active-mode-label">{lang === 'en' ? 'Current Focus:' : 'Aktiver Fokusbereich:'}</span>
    <span class="active-mode-name" id="active-mode-display-name">
      {lang === 'en' ? '🎙️ Multi-Speaker Audio Dialogues' : '🎙️ Multi-Speaker Audio-Dialoge'}
    </span>
    <span class="active-mode-hint">
      {lang === 'en' ? '(Click any card above to dynamically switch visible content)' : '(Klicke oben auf eine Kachel, um die sichtbaren Inhalte live umzuschalten)'}
    </span>
  </div>
</nav>

<script>
  function setupStudyDashboard() {
    const nav = document.getElementById('study-mode-dashboard-nav');
    if (!nav) return;

    const cards = nav.querySelectorAll<HTMLButtonElement>('.nav-card');
    const btnToggleAll = document.getElementById('btn-toggle-all-modes');
    const activeName = document.getElementById('active-mode-display-name');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.study-mode-section'));

    if (sections.length === 0) {
      return;
    }

    const modeLabels: Record<string, { de: string; en: string }> = {
      dialogues: {
        de: '🎙️ Multi-Speaker Audio-Dialoge (18 Lektions-Dialoge)',
        en: '🎙️ Multi-Speaker Audio Dialogues (18 Lesson Dialogues)'
      },
      grammar: {
        de: '📐 Systematischer Grammatik-Explorer (26 Regeln & Confusables)',
        en: '📐 Systematic Grammar Explorer (26 Rules & Confusables)'
      },
      vocab: {
        de: '🔤 Vokabel-Lexikon & Vault (579 Wörter mit Pinyin-Recall & Strichfolge)',
        en: '🔤 Vocabulary Lexicon & Vault (579 Words with Pinyin Recall & Stroke Guide)'
      },
      tones: {
        de: '🇨🇳 Tonsystem & Tone Sandhi (Aussprache & Töne)',
        en: '🇨🇳 Tonal System & Tone Sandhi (Pronunciation & Tones)'
      },
      assets: {
        de: '🗂️ Kurs-Assets & Anki-Deck (Work In Progress)',
        en: '🗂️ Course Assets & Anki Deck (Work In Progress)'
      },
      all: {
        de: '🌐 Alle Bereiche aktiv (Vollansicht ohne Filterung)',
        en: '🌐 All Sections Active (Full Document View)'
      }
    };

    function switchMode(targetMode: string, updateHash: boolean = true) {
      const isAll = targetMode === 'all';

      // Update Cards
      cards.forEach((card) => {
        const matches = card.dataset.modeId === targetMode;
        card.classList.toggle('active', !isAll && matches);
      });

      // Update Toggle All Button
      if (btnToggleAll) {
        btnToggleAll.classList.toggle('active', isAll);
      }

      // Update Display Text
      if (activeName) {
        const isEn = document.documentElement.lang?.startsWith('en') || window.location.pathname.includes('/en/');
        const labelObj = modeLabels[targetMode] || modeLabels['dialogues'];
        activeName.textContent = isEn ? labelObj.en : labelObj.de;
      }

      // Dynamically Show / Hide Sections on the Page
      sections.forEach((sec) => {
        const secMode = sec.dataset.studyMode || sec.id.replace('study-mode-', '');
        if (isAll) {
          sec.style.display = 'block';
          sec.classList.remove('study-section-hidden');
          sec.classList.add('study-section-visible');
        } else {
          const isMatch = secMode === targetMode;
          if (isMatch) {
            sec.style.display = 'block';
            sec.classList.remove('study-section-hidden');
            sec.classList.add('study-section-visible');
          } else {
            sec.style.display = 'none';
            sec.classList.add('study-section-hidden');
            sec.classList.remove('study-section-visible');
          }
        }
      });

      // Update URL hash without jumping page
      if (updateHash && window.history.replaceState) {
        const hash = isAll ? '#all' : `#${targetMode}`;
        window.history.replaceState(null, '', hash);
      }
    }

    // Attach Click Handlers to Cards
    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const mode = card.dataset.modeId || 'dialogues';
        switchMode(mode, true);

        // Smooth scroll to the content area
        const targetSec = document.getElementById(`study-mode-${mode}`);
        if (targetSec) {
          targetSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Toggle All Button
    if (btnToggleAll) {
      btnToggleAll.addEventListener('click', (e) => {
        e.preventDefault();
        const currentlyAll = btnToggleAll.classList.contains('active');
        switchMode(currentlyAll ? 'dialogues' : 'all', true);
      });
    }

    // Initialize from URL Hash if present
    const hash = window.location.hash.replace('#', '').toLowerCase();
    const validModes = ['dialogues', 'grammar', 'tones', 'assets', 'all'];
    if (validModes.includes(hash)) {
      switchMode(hash, false);
    } else {
      // Default to dialogues mode
      switchMode('dialogues', false);
    }

    // Handle hashchange event (browser back/forward)
    window.addEventListener('hashchange', () => {
      const newHash = window.location.hash.replace('#', '').toLowerCase();
      if (validModes.includes(newHash)) {
        switchMode(newHash, false);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupStudyDashboard);
  document.addEventListener('astro:page-load', setupStudyDashboard);
</script>

<style>
  .study-dashboard-nav {
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.08), transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(56, 189, 248, 0.06), transparent 45%),
                var(--sl-color-gray-6, #131419);
    border: 1px solid var(--sl-color-gray-5, #232530);
    border-radius: 16px;
    padding: 1.35rem;
    gap: 1.1rem;
    margin: 1.5rem 0 2.25rem 0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  }

  .nav-intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.75rem;
  }

  .nav-intro-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6366f1;
    box-shadow: 0 0 8px #6366f1;
  }

  .mode-badge {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--sl-color-accent-high, #818cf8);
    letter-spacing: 0.06em;
  }

  .btn-show-all-modes {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--sl-color-gray-5, #334155);
    color: var(--sl-color-gray-3, #94a3b8);
    padding: 0.35rem 0.8rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .btn-show-all-modes:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--sl-color-white, #ffffff);
  }

  .btn-show-all-modes.active {
    background: rgba(56, 189, 248, 0.18);
    border-color: #38bdf8;
    color: #38bdf8;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
  }

  /* Grid of Cards */
  .nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  @media (min-width: 640px) {
    .nav-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1060px) {
    .nav-grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    background: var(--sl-color-gray-6, #16171d);
    border: 1px solid var(--sl-color-gray-5, #262833);
    border-radius: 12px;
    padding: 1.1rem;
    gap: 0.45rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .nav-card:hover {
    border-color: var(--sl-color-accent, #6366f1);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.18);
    background: var(--sl-color-gray-6, #1c1d25);
  }

  .nav-card.active {
    background: rgba(99, 102, 241, 0.12);
    border-color: var(--sl-color-accent-high, #818cf8);
    box-shadow: 0 0 0 2px var(--sl-color-accent, #6366f1), 0 8px 24px rgba(99, 102, 241, 0.25);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-icon {
    font-size: 1.5rem;
  }

  .card-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
  }

  .card-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--sl-color-white, #f8fafc);
    margin: 0.2rem 0 0 0;
    line-height: 1.35;
  }

  .card-desc {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3, #94a3b8);
    margin: 0;
    line-height: 1.45;
  }

  .active-indicator {
    display: none;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--sl-color-accent-high, #a5b4fc);
    margin-top: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .nav-card.active .active-indicator {
    display: flex;
  }

  /* Bottom Active Mode Bar */
  .mode-active-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 10px;
    padding: 0.6rem 1rem;
    font-size: 0.84rem;
    flex-wrap: wrap;
  }

  .active-mode-label {
    font-weight: 700;
    color: var(--sl-color-gray-3, #94a3b8);
    font-size: 0.76rem;
    text-transform: uppercase;
  }

  .active-mode-name {
    font-weight: 700;
    color: #38bdf8;
  }

  .active-mode-hint {
    font-size: 0.76rem;
    color: var(--sl-color-gray-4, #64748b);
    margin-left: auto;
  }

  /* Global Animations for Sections */
  :global(.study-section-visible) {
    animation: studyFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes studyFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
