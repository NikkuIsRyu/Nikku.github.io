---
// Flagship project card for the homepage. Body text goes in the default slot.
interface Link {
	label: string;
	href: string;
}
interface Props {
	title: string;
	image: string;
	imageAlt: string;
	tags?: string[];
	links?: Link[];
	/** Pixel art: keep hard edges when the thumbnail is scaled. */
	pixel?: boolean;
}

const { title, image, imageAlt, tags = [], links = [], pixel = false } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const tagsLabel = Astro.currentLocale === 'de' ? 'Technologien' : 'Tech stack';
---

<article class="project-card not-content">
	<img
		class:list={['project-thumb', { pixel }]}
		src={image}
		alt={imageAlt}
		width="640"
		height="360"
		loading="lazy"
		decoding="async"
	/>
	<div class="project-body">
		<h3>{title}</h3>
		<div class="project-text"><slot /></div>
		{tags.length > 0 && (
			<ul class="project-tags" aria-label={tagsLabel}>
				{tags.map((tag) => <li>{tag}</li>)}
			</ul>
		)}
		{links.length > 0 && (
			<div class="project-links">
				{links.map((link) => (
					<a
						href={link.href}
						{...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{link.label}
						<span aria-hidden="true">{isExternal(link.href) ? '↗' : '→'}</span>
					</a>
				))}
			</div>
		)}
	</div>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background-color: color-mix(in srgb, var(--sl-color-bg) 82%, transparent);
		backdrop-filter: blur(6px);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}
	.project-card:hover {
		transform: translateY(-2px);
		border-color: var(--sl-color-accent);
	}
	.project-thumb {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.project-thumb.pixel {
		image-rendering: pixelated;
	}
	.project-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem 1.15rem 1.15rem;
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
		line-height: 1.3;
	}
	.project-text {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	.project-text :global(p) {
		margin: 0;
	}
	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.project-tags li {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
	}
	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: auto;
		padding-top: 0.25rem;
	}
	.project-links a {
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
	}
	.project-links a span {
		margin-left: 0.3em;
	}
	.project-links a:hover {
		text-decoration: underline;
	}
	@media (prefers-reduced-motion: reduce) {
		.project-card {
			transition: none;
		}
		.project-card:hover {
			transform: none;
		}
	}
</style>
