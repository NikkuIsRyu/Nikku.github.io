		.controls-row {
			gap: 0.5rem;
		}
		.btn-play-master {
			width: 38px;
			height: 38px;
		}
	}
</style>

<script>
	// Initialize all dialogue players on the page
	function initDialoguePlayers() {
		const players = document.querySelectorAll<HTMLElement>('.dialogue-player-card');

		players.forEach((player) => {
			const audio = player.querySelector<HTMLAudioElement>('.player-audio');
			const btnPlay = player.querySelector<HTMLButtonElement>('.btn-play-master');
			const iconPlay = btnPlay?.querySelector<HTMLElement>('.icon-play');
			const iconPause = btnPlay?.querySelector<HTMLElement>('.icon-pause');
			const progressFill = player.querySelector<HTMLElement>('.progress-bar-fill');
			const progressScrubber = player.querySelector<HTMLInputElement>('.progress-scrubber');
			const timeCurrent = player.querySelector<HTMLElement>('.time-current');
			const timeTotal = player.querySelector<HTMLElement>('.time-total');
			const turnRows = player.querySelectorAll<HTMLElement>('.turn-row');
			const speedButtons = player.querySelectorAll<HTMLButtonElement>('.btn-speed');

			const btnTogglePinyin = player.querySelector<HTMLButtonElement>('[data-action="toggle-pinyin"]');
			const btnToggleTrans = player.querySelector<HTMLButtonElement>('[data-action="toggle-trans"]');
			const btnToggleLoop = player.querySelector<HTMLButtonElement>('[data-action="toggle-loop-turn"]');

			if (!audio || !btnPlay) return;

			let isLoopingTurn = false;
			let activeLoopTurn: HTMLElement | null = null;

			function formatTime(secs: number): string {
				const m = Math.floor(secs / 60).toString().padStart(2, '0');
				const s = Math.floor(secs % 60).toString().padStart(2, '0');
				return `${m}:${s}`;
			}

			// Play / Pause Master
			btnPlay.addEventListener('click', () => {
				if (audio.paused) {
					// Pause any other playing audio on the page
					document.querySelectorAll('audio').forEach((a) => {
						if (a !== audio && !a.paused) a.pause();
					});
					audio.play();
				} else {
					audio.pause();
				}
			});

			audio.addEventListener('play', () => {
				if (iconPlay) iconPlay.style.display = 'none';
				if (iconPause) iconPause.style.display = 'inline';
			});

			audio.addEventListener('pause', () => {
				if (iconPlay) iconPlay.style.display = 'inline';
				if (iconPause) iconPause.style.display = 'none';
			});

			audio.addEventListener('ended', () => {
				if (iconPlay) iconPlay.style.display = 'inline';
				if (iconPause) iconPause.style.display = 'none';
				turnRows.forEach((row) => row.classList.remove('is-active-turn'));
				if (progressFill) progressFill.style.width = '0%';
				if (progressScrubber) progressScrubber.value = '0';
				if (timeCurrent) timeCurrent.textContent = '00:00';
			});

			audio.addEventListener('loadedmetadata', () => {
				if (timeTotal && !isNaN(audio.duration)) {
					timeTotal.textContent = formatTime(audio.duration);
				}
				if (progressScrubber && !isNaN(audio.duration)) {
					progressScrubber.max = audio.duration.toString();
				}
			});

			// Timeupdate & Karaoke Highlight
			audio.addEventListener('timeupdate', () => {
				const cur = audio.currentTime;
				const dur = audio.duration || 1;

				if (timeCurrent) timeCurrent.textContent = formatTime(cur);

				const percent = Math.min(100, Math.max(0, (cur / dur) * 100));
				if (progressFill) progressFill.style.width = `${percent}%`;
				if (progressScrubber) progressScrubber.value = cur.toString();

				// Check loop mode
				if (isLoopingTurn && activeLoopTurn) {
					const loopStart = parseFloat(activeLoopTurn.dataset.start || '0');
					const loopEnd = parseFloat(activeLoopTurn.dataset.end || '0');
					if (cur >= loopEnd) {
						audio.currentTime = loopStart;
						audio.play();
						return;
					}
				}

				// Highlight active turn
				turnRows.forEach((row) => {
					const start = parseFloat(row.dataset.start || '0');
					const end = parseFloat(row.dataset.end || '0');
					if (cur >= start && cur <= end) {
						if (!row.classList.contains('is-active-turn')) {
							row.classList.add('is-active-turn');
						}
					} else {
						row.classList.remove('is-active-turn');
					}
				});
			});

			// Scrubber Input
			progressScrubber?.addEventListener('input', () => {
				const seekTime = parseFloat(progressScrubber.value);
				audio.currentTime = seekTime;
				if (progressFill && audio.duration) {
					progressFill.style.width = `${(seekTime / audio.duration) * 100}%`;
				}
			});

			// Speed Switcher
			speedButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					speedButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					const speed = parseFloat(btn.dataset.speed || '1.0');
					audio.playbackRate = speed;
				});
			});

			// Individual Turn Play Buttons
			turnRows.forEach((row) => {
				const btnTurnPlay = row.querySelector<HTMLButtonElement>('.btn-play-turn');
				const start = parseFloat(row.dataset.start || '0');
				const end = parseFloat(row.dataset.end || '0');

				btnTurnPlay?.addEventListener('click', (e) => {
					e.stopPropagation();
					activeLoopTurn = row;
					audio.currentTime = start;
					// Pause others
					document.querySelectorAll('audio').forEach((a) => {
						if (a !== audio && !a.paused) a.pause();
					});
					audio.play();
				});

				// Clicking the row itself also seeks to the turn
				row.addEventListener('click', () => {
					activeLoopTurn = row;
					audio.currentTime = start;
					document.querySelectorAll('audio').forEach((a) => {
						if (a !== audio && !a.paused) a.pause();
					});
					audio.play();
				});
			});

			// Practice Toggles
			btnTogglePinyin?.addEventListener('click', () => {
				player.classList.toggle('hide-pinyin');
				btnTogglePinyin.classList.toggle('active');
			});

			btnToggleTrans?.addEventListener('click', () => {
				player.classList.toggle('hide-trans');
				btnToggleTrans.classList.toggle('active');
			});

			btnToggleLoop?.addEventListener('click', () => {
				isLoopingTurn = !isLoopingTurn;
				btnToggleLoop.classList.toggle('active', isLoopingTurn);
			});
		});
	}

	// Run on initial load and on Astro page transitions
	document.addEventListener('DOMContentLoaded', initDialoguePlayers);
	document.addEventListener('astro:page-load', initDialoguePlayers);
</script>
