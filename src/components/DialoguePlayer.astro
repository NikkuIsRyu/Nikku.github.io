---
import type { DialogueData } from '../data/chineseDialogues';

interface Props {
	dialogue: DialogueData;
	driveFolderHref?: string;
}

const {
	dialogue,
	driveFolderHref = 'https://drive.google.com/drive/folders/1w3qC6G6t4q0f5o2G1L7n5d3jX' // fallback to drive
} = Astro.props;

const containerId = `dialogue-player-${dialogue.id}`;
---

<div class="dialogue-player-card not-content" id={containerId} data-dialogue-id={dialogue.id}>
	<!-- Header -->
	<div class="player-header">
		<div class="header-main">
			<div class="lesson-badge">{dialogue.lesson}</div>
			<h3 class="dialogue-title">{dialogue.title}</h3>
			<div class="chinese-title">{dialogue.chineseTitle}</div>
		</div>
		<div class="header-meta">
			<span class="topic-tag">{dialogue.topic}</span>
			<span class="duration-badge">⏱️ {dialogue.durationS.toFixed(1)}s</span>
		</div>
	</div>

	<p class="dialogue-desc">{dialogue.description}</p>

	<!-- Speakers Summary Bar -->
	<div class="speakers-bar">
		<span class="speakers-label">Rollen & Stimmen:</span>
		<div class="speakers-list">
			{Object.entries(dialogue.speakers).map(([key, spk]) => (
				<span class="speaker-chip" style={`--spk-color: ${spk.color};`}>
					<span class="spk-indicator"></span>
					<strong>{key}:</strong> {spk.label} <span class="voice-name">({spk.voiceLabel})</span>
				</span>
			))}
		</div>
	</div>

	<!-- Audio Control Center -->
	<div class="audio-control-panel">
		<audio class="player-audio" preload="metadata" src={dialogue.audioSrc}></audio>

		<div class="controls-row">
			<button type="button" class="btn-play-master" aria-label="Audio abspielen oder pausieren">
				<span class="icon-play">▶</span>
				<span class="icon-pause" style="display: none;">❚❚</span>
			</button>

			<div class="time-progress-wrap">
				<div class="progress-bar-container">
					<div class="progress-bar-fill"></div>
					<input type="range" class="progress-scrubber" min="0" max={dialogue.durationS} step="0.05" value="0" aria-label="Wiedergabe-Fortschritt" />
				</div>
				<div class="time-display">
					<span class="time-current">00:00</span> / <span class="time-total">{Math.floor(dialogue.durationS / 60).toString().padStart(2, '0')}:{(Math.floor(dialogue.durationS % 60)).toString().padStart(2, '0')}</span>
				</div>
			</div>

			<div class="speed-control-group">
				<span class="speed-label">Tempo:</span>
				<button type="button" class="btn-speed active" data-speed="1.0">1.0x</button>
				<button type="button" class="btn-speed" data-speed="0.85">0.85x</button>
				<button type="button" class="btn-speed" data-speed="0.7">0.7x</button>
			</div>
		</div>

		<!-- Interactive Practice Toolbar -->
		<div class="practice-toolbar">
			<div class="toggle-group">
				<button type="button" class="btn-tool active" data-action="toggle-pinyin" title="Pinyin anzeigen oder ausblenden">
					<span class="tool-icon">🔤</span> Pinyin
				</button>
				<button type="button" class="btn-tool active" data-action="toggle-trans" title="Deutsche Übersetzung anzeigen oder ausblenden">
					<span class="tool-icon">🇩🇪</span> Übersetzung
				</button>
				<button type="button" class="btn-tool" data-action="toggle-loop-turn" title="Aktuellen Satz wiederholen (Shadowing)">
					<span class="tool-icon">🔁</span> Satz-Loop
				</button>
			</div>

			<div class="asset-links-group">
				<a href={`/audio/dialogues/${dialogue.id}_timestamps.json`} target="_blank" rel="noopener noreferrer" class="tool-link-btn" title="Exakte Frame- und Zeitstempel als JSON öffnen">
					<span>📄 JSON Timestamps</span>
				</a>
				<a href={driveFolderHref} target="_blank" rel="noopener noreferrer" class="tool-link-btn primary" title="Lossless 32 kHz WAV Studio-Master auf Google Drive öffnen">
					<span>Lossless WAV (Drive) ↗</span>
				</a>
			</div>
		</div>
	</div>

	<!-- Transcript / Turns Stream -->
	<div class="turns-container">
		{dialogue.turns.map((turn) => {
			const spkInfo = dialogue.speakers[turn.speaker] || {
				color: '#3b82f6',
				gender: 'male',
				label: turn.speaker,
				voiceLabel: turn.voiceLabel
			};

			return (
				<div
					class={`turn-row turn-speaker-${turn.speaker}`}
					data-turn-idx={turn.idx}
					data-start={turn.startS}
					data-end={turn.endS}
					style={`--spk-color: ${spkInfo.color};`}
				>
					<div class="speaker-avatar" title={`${spkInfo.label} (${spkInfo.voiceLabel})`}>
						<span class="avatar-letter">{turn.speaker}</span>
					</div>

					<div class="turn-bubble">
						<div class="turn-top-bar">
							<span class="turn-speaker-title">
								{spkInfo.label} <span class="voice-badge">{turn.voiceLabel}</span>
							</span>
							<div class="turn-actions">
								<span class="turn-timestamp">{turn.startS.toFixed(1)}s – {turn.endS.toFixed(1)}s</span>
								<button type="button" class="btn-play-turn" title="Diesen Einzelsatz abspielen" aria-label={`Satz ${turn.idx} abspielen`}>
									▶
								</button>
							</div>
						</div>

						<div class="turn-hanzi">{turn.hanzi}</div>
						<div class="turn-pinyin">{turn.pinyin}</div>
						<div class="turn-translation">{turn.translation}</div>
					</div>
				</div>
			);
		})}
	</div>
</div>

<style>
