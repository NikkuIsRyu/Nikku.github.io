---
interface Props {
  lang?: 'de' | 'en';
  scriptMode?: 'ja' | 'zh';
  defaultChar?: string;
  isModalOnly?: boolean;
}

const {
  lang = 'de',
  scriptMode = 'zh',
  defaultChar = scriptMode === 'ja' ? '日' : '你',
  isModalOnly = false,
} = Astro.props;

const jaSuggestions = [
  { char: '日', reading: 'にち / ひ', meaning: 'Tag, Sonne / sun' },
  { char: '本', reading: 'ほん', meaning: 'Buch, Ursprung / origin' },
  { char: '語', reading: 'ご', meaning: 'Sprache / language' },
  { char: '学', reading: 'がく / まなぶ', meaning: 'lernen / study' },
  { char: '生', reading: 'せい / いきる', meaning: 'Leben / life' },
  { char: '見', reading: 'けん / みる', meaning: 'sehen / see' },
  { char: '食', reading: 'しょく / たべる', meaning: 'essen / eat' },
  { char: '行', reading: 'こう / いく', meaning: 'gehen / go' },
];

const zhSuggestions = [
  { char: '你', reading: 'nǐ', meaning: 'du / you' },
  { char: '好', reading: 'hǎo', meaning: 'gut / good' },
  { char: '学', reading: 'xué', meaning: 'lernen / learn' },
  { char: '生', reading: 'shēng', meaning: 'geboren / life' },
  { char: '见', reading: 'jiàn', meaning: 'sehen / see' },
  { char: '日', reading: 'rì', meaning: 'Tag, Sonne / sun' },
  { char: '中', reading: 'zhōng', meaning: 'Mitte / center' },
  { char: '国', reading: 'guó', meaning: 'Land / country' },
];

const suggestions = scriptMode === 'ja' ? jaSuggestions : zhSuggestions;
---

<!-- Stroke Order Modal & Interactive Character Studio -->
<div class="stroke-order-guide not-content notranslate" translate="no" id="stroke-order-guide-root" data-script-mode={scriptMode}>
  <!-- Modal Dialog -->
  <div class="stroke-modal-backdrop" id="stroke-modal-backdrop" style="display: none;">
    <div class="stroke-modal-panel" role="dialog" aria-modal="true" aria-labelledby="stroke-modal-title">
      <!-- Modal Header -->
      <div class="stroke-modal-header">
        <div class="modal-title-group">
          <span class="stroke-guide-badge" id="stroke-modal-badge">
            ✍️ {scriptMode === 'ja'
              ? (lang === 'en' ? 'Kanji Stroke Order Guide & Practice' : 'Kanji-Strichfolge & Schreibtrainer')
              : (lang === 'en' ? 'Hanzi Stroke Order Guide & Practice' : 'Hanzi-Strichfolge & Schreibtrainer')}
          </span>
          <h3 id="stroke-modal-title" class="stroke-modal-heading">
            <span class="active-char-display" id="modal-active-char">{defaultChar}</span>
            <span class="active-char-pinyin" id="modal-active-pinyin"></span>
          </h3>
        </div>
        <button type="button" class="btn-modal-close" id="stroke-modal-close" title={lang === 'en' ? 'Close' : 'Schließen'}>✕</button>
      </div>

      <!-- Word Kanji Pills (active when inspected term contains multiple Kanji) -->
      <div class="word-kanji-row" id="stroke-word-kanji-row" style="display: none;">
        <span class="word-kanji-label">{lang === 'en' ? 'Kanji in this word:' : 'Kanji in dieser Vokabel:'}</span>
        <div class="word-kanji-pills" id="modal-word-kanji-pills"></div>
      </div>

      <!-- Quick Character Input / Switcher -->
      <div class="stroke-char-selector-row">
        <div class="char-input-wrap">
          <input
            type="text"
            id="stroke-char-input"
            class="stroke-char-input"
            placeholder={scriptMode === 'ja'
              ? (lang === 'en' ? 'Type any Kanji (e.g. 学, 見, 食, 勉)...' : 'Beliebiges Kanji eingeben (z. B. 学, 見, 食, 勉)...')
              : (lang === 'en' ? 'Type any character (e.g. 你, 好, 学)...' : 'Beliebiges Zeichen eingeben (z. B. 你, 好, 学)...')}
            maxlength="2"
            autocomplete="off"
          />
          <button type="button" id="stroke-char-submit" class="btn-char-submit">
            {lang === 'en' ? 'Inspect' : 'Laden'}
          </button>
        </div>

        <div class="quick-char-pills">
          <span class="quick-label">{lang === 'en' ? 'Examples:' : 'Beispiele:'}</span>
          {suggestions.map((s) => (
            <button
              type="button"
              class="btn-quick-char"
              data-char={s.char}
              title={`${s.char} (${s.reading} - ${s.meaning})`}
            >
              {s.char}
            </button>
          ))}
        </div>
      </div>

      <!-- Main Canvas & Interactive Studio -->
      <div class="stroke-studio-layout">
        <!-- Canvas Box -->
        <div class="stroke-canvas-container">
          <div class="canvas-grid-box" id="stroke-canvas-box">
            <!-- HanziWriter / SVG Target -->
            <div id="stroke-writer-target" class="stroke-writer-target"></div>
          </div>
          <div class="canvas-caption">
            <span id="stroke-mode-caption">{lang === 'en' ? 'Strokes are numbered in standard order' : 'Striche in normierter Reihenfolge'}</span>
          </div>
        </div>

        <!-- Controls & Meta Panel -->
        <div class="stroke-controls-panel">
          <div class="stroke-meta-card">
            <div class="meta-item">
              <span class="meta-label">{lang === 'en' ? 'Total Strokes:' : 'Strichanzahl:'}</span>
              <strong class="meta-value" id="stroke-count-value">—</strong>
            </div>
            <div class="meta-item">
              <span class="meta-label">{lang === 'en' ? 'Status / Mode:' : 'Modus:'}</span>
              <span class="meta-status" id="stroke-status-value">{lang === 'en' ? 'Ready' : 'Bereit'}</span>
            </div>
          </div>

          <!-- Playback Actions -->
          <div class="stroke-actions-grid">
            <button type="button" class="btn-stroke-act btn-act-play" id="btn-stroke-play">
              <span class="act-icon">▶</span>
              <span class="act-text">{lang === 'en' ? 'Animate' : 'Animieren'}</span>
            </button>

            <button type="button" class="btn-stroke-act" id="btn-stroke-step">
              <span class="act-icon">⏯</span>
              <span class="act-text">{lang === 'en' ? 'Next Stroke' : 'Nächster Strich'}</span>
            </button>

            <button type="button" class="btn-stroke-act" id="btn-stroke-loop">
              <span class="act-icon">🔁</span>
              <span class="act-text">{lang === 'en' ? 'Loop' : 'Endlosschleife'}</span>
            </button>

            <button type="button" class="btn-stroke-act" id="btn-stroke-reset">
              <span class="act-icon">⏮</span>
              <span class="act-text">{lang === 'en' ? 'Reset' : 'Zurücksetzen'}</span>
            </button>
          </div>

          <!-- Interactive Writing Quiz -->
          <div class="quiz-action-card">
            <button type="button" class="btn-stroke-quiz" id="btn-stroke-quiz">
              <span class="quiz-icon">✏️</span>
              <span class="quiz-title">{lang === 'en' ? 'Interactive Writing Practice' : 'Interaktives Schreibtraining'}</span>
            </button>
            <p class="quiz-hint">
              {lang === 'en'
                ? 'Draw the character on the canvas with your mouse or touchscreen. The trainer checks stroke order in real time!'
                : 'Zeichne das Schriftzeichen mit Maus oder Touchscreen nach. Der Trainer prüft jeden Strich in Echtzeit!'}
            </p>
          </div>
        </div>
      </div>

      <!-- Step-by-Step Breakdown Diagram Container -->
      <div class="stroke-steps-section">
        <h5 class="steps-heading">
          <span>{lang === 'en' ? 'Step-by-Step Stroke Evolution' : 'Schritt-für-Schritt Strichabfolge'}</span>
        </h5>
        <div class="steps-scroll-row" id="stroke-steps-container">
          <!-- Populated dynamically -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let hanziWriterLoaded = false;
  let currentWriter: any = null;
  let currentChar = '日';
  let isQuizActive = false;
  let isLooping = false;
  let activeScriptMode = 'zh';

  // Load HanziWriter dynamically on-demand from CDN
  function loadHanziWriter(): Promise<void> {
    if (hanziWriterLoaded && (window as any).HanziWriter) return Promise.resolve();

    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/hanzi-writer@3.5/dist/hanzi-writer.min.js';
      script.async = true;
      script.onload = () => {
        hanziWriterLoaded = true;
        resolve();
      };
      script.onerror = () => reject(new Error('Failed to load HanziWriter'));
      document.head.appendChild(script);
    });
  }

  function setupStrokeGuide() {
    const root = document.getElementById('stroke-order-guide-root');
    if (!root) return;

    activeScriptMode = root.dataset.scriptMode || (window.location.pathname.includes('/languages/japanese/') ? 'ja' : 'zh');

    const modal = document.getElementById('stroke-modal-backdrop');
    const btnClose = document.getElementById('stroke-modal-close');
    const target = document.getElementById('stroke-writer-target');
    const activeCharDisplay = document.getElementById('modal-active-char');
    const activePinyinDisplay = document.getElementById('modal-active-pinyin');
    const strokeCountDisplay = document.getElementById('stroke-count-value');
    const strokeStatusDisplay = document.getElementById('stroke-status-value');
    const stepsContainer = document.getElementById('stroke-steps-container');
    const wordKanjiRow = document.getElementById('stroke-word-kanji-row');
    const wordKanjiPills = document.getElementById('modal-word-kanji-pills');
    const modalBadge = document.getElementById('stroke-modal-badge');

    const btnPlay = document.getElementById('btn-stroke-play');
    const btnStep = document.getElementById('btn-stroke-step');
    const btnLoop = document.getElementById('btn-stroke-loop');
    const btnReset = document.getElementById('btn-stroke-reset');
    const btnQuiz = document.getElementById('btn-stroke-quiz');

    const inputChar = document.getElementById('stroke-char-input') as HTMLInputElement | null;
    const btnSubmit = document.getElementById('stroke-char-submit');
    const quickButtons = root.querySelectorAll<HTMLButtonElement>('.btn-quick-char');

    // Open Modal
    function openModal(char: string, reading = '', eventLang = '') {
      if (!modal) return;
      modal.style.display = 'flex';

      const langMode = eventLang || (window.location.pathname.includes('/languages/japanese/') ? 'ja' : activeScriptMode);
      activeScriptMode = langMode;

      // Update badge dynamically
      if (modalBadge) {
        const isEn = document.documentElement.lang?.startsWith('en') || (window.location.pathname.includes('/languages/japanese/') && !window.location.pathname.includes('/de/'));
        if (activeScriptMode === 'ja') {
          modalBadge.textContent = isEn ? '✍️ Kanji Stroke Order Guide & Practice' : '✍️ Kanji-Strichfolge & Schreibtrainer';
        } else {
          modalBadge.textContent = isEn ? '✍️ Hanzi Stroke Order Guide & Practice' : '✍️ Hanzi-Strichfolge & Schreibtrainer';
        }
      }

      // Extract all CJK Ideographs / Kanji from the term
      const kanjiList = (char.match(/[\u4e00-\u9faf]/g) || []);

      // If word contains multiple Kanji, render selectable tabs/pills
      if (wordKanjiRow && wordKanjiPills) {
        if (kanjiList.length > 1) {
          wordKanjiRow.style.display = 'flex';
          wordKanjiPills.innerHTML = '';
          kanjiList.forEach((k, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `btn-word-kanji ${idx === 0 ? 'active' : ''}`;
            btn.textContent = k;
            btn.title = `Strichfolge für ${k} anzeigen`;
            btn.addEventListener('click', () => {
              wordKanjiPills.querySelectorAll('.btn-word-kanji').forEach((b) => b.classList.remove('active'));
              btn.classList.add('active');
              currentChar = k;
              if (activeCharDisplay) activeCharDisplay.textContent = k;
              if (inputChar) inputChar.value = k;
              initWriterForChar(k);
            });
            wordKanjiPills.appendChild(btn);
          });
        } else {
          wordKanjiRow.style.display = 'none';
          wordKanjiPills.innerHTML = '';
        }
      }

      // Determine initial active character
      if (kanjiList.length > 0) {
        currentChar = kanjiList[0];
      } else {
        currentChar = char.trim().charAt(0) || (activeScriptMode === 'ja' ? '日' : '你');
      }

      if (activeCharDisplay) activeCharDisplay.textContent = currentChar;
      if (activePinyinDisplay) {
        activePinyinDisplay.textContent = reading ? `[${reading}]` : '';
      }
      if (inputChar) inputChar.value = currentChar;

      initWriterForChar(currentChar);
    }

    // Close Modal
    function closeModal() {
      if (!modal) return;
      modal.style.display = 'none';
      if (currentWriter) {
        if (isLooping) currentWriter.cancelQuiz();
      }
      isLooping = false;
      isQuizActive = false;
    }

    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Global Event Listener
    window.addEventListener('nikku:open-stroke-guide', (e: any) => {
      const char = e.detail?.char || (activeScriptMode === 'ja' ? '日' : '你');
      const reading = e.detail?.reading || e.detail?.pinyin || '';
      const eventLang = e.detail?.lang || (window.location.pathname.includes('/languages/japanese/') ? 'ja' : 'zh');
      openModal(char, reading, eventLang);
    });

    // Quick Character Pills
    quickButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const c = btn.dataset.char || (activeScriptMode === 'ja' ? '日' : '你');
        currentChar = c;
        if (activeCharDisplay) activeCharDisplay.textContent = c;
        if (inputChar) inputChar.value = c;
        if (wordKanjiRow) wordKanjiRow.style.display = 'none';
        initWriterForChar(c);
      });
    });

    // Custom Char Input
    function handleCustomInput() {
      if (!inputChar) return;
      const raw = inputChar.value.trim();
      if (!raw) return;
      // Get first CJK ideograph
      const c = raw.charAt(0);
      currentChar = c;
      if (activeCharDisplay) activeCharDisplay.textContent = c;
      if (wordKanjiRow) wordKanjiRow.style.display = 'none';
      initWriterForChar(c);
    }

    if (btnSubmit) btnSubmit.addEventListener('click', handleCustomInput);
    if (inputChar) {
      inputChar.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleCustomInput();
      });
    }

    // Initialize Character in HanziWriter
    async function initWriterForChar(char: string) {
      if (!target) return;
      target.innerHTML = '';
      if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Lade Zeichendaten...';
      isQuizActive = false;
      isLooping = false;

      try {
        await loadHanziWriter();
        const HanziWriter = (window as any).HanziWriter;
        if (!HanziWriter) return;

        // Custom loader: prioritize dataset according to active script mode
        const charDataLoader = async (c: string, onComplete: any, onError: any) => {
          const isJa = activeScriptMode === 'ja';

          if (isJa) {
            // 1. Try Japanese KanjiVG dataset first for authentic JIS stroke order
            try {
              const resJp = await fetch(`https://cdn.jsdelivr.net/npm/hanzi-writer-data-jp@0/${c}.json`);
              if (resJp.ok) {
                const dataJp = await resJp.json();
                return onComplete(dataJp);
              }
            } catch {}

            // 2. Fallback to standard Chinese dataset
            try {
              const res = await fetch(`https://cdn.jsdelivr.net/npm/hanzi-writer-data@2.0/${c}.json`);
              if (res.ok) {
                const data = await res.json();
                return onComplete(data);
              }
            } catch {}
          } else {
            // 1. Try Chinese dataset first
            try {
              const res = await fetch(`https://cdn.jsdelivr.net/npm/hanzi-writer-data@2.0/${c}.json`);
              if (res.ok) {
                const data = await res.json();
                return onComplete(data);
              }
            } catch {}

            // 2. Fallback to Japanese dataset
            try {
              const resJp = await fetch(`https://cdn.jsdelivr.net/npm/hanzi-writer-data-jp@0/${c}.json`);
              if (resJp.ok) {
                const dataJp = await resJp.json();
                return onComplete(dataJp);
              }
            } catch {}
          }

          onError(new Error('Character not found in database'));
        };

        currentWriter = HanziWriter.create('stroke-writer-target', char, {
          width: 220,
          height: 220,
          padding: 15,
          showOutline: true,
          strokeAnimationSpeed: 1.2,
          delayBetweenStrokes: 150,
          strokeColor: '#f43f5e',
          outlineColor: 'rgba(255, 255, 255, 0.15)',
          drawingColor: '#34d399',
          charDataLoader
        });

        // Query Character Stroke Data
        HanziWriter.loadCharacterData(char, { charDataLoader }).then((charData: any) => {
          if (charData && charData.strokes) {
            const count = charData.strokes.length;
            if (strokeCountDisplay) strokeCountDisplay.textContent = count.toString();
            if (strokeStatusDisplay) strokeStatusDisplay.textContent = `${count} Striche geladen`;

            // Render Step-by-Step previews
            renderStepsBreakdown(char, charData);
          }
        }).catch(() => {
          if (strokeCountDisplay) strokeCountDisplay.textContent = '—';
          if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Keine Vektordaten gefunden';
        });

        // Initial animation
        currentWriter.animateCharacter();

      } catch (err) {
        if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Fehler beim Laden';
      }
    }

    // Render Step-by-Step Mini Diagrams
    function renderStepsBreakdown(char: string, charData: any) {
      if (!stepsContainer) return;
      stepsContainer.innerHTML = '';
      const strokes = charData.strokes || [];
      const HanziWriter = (window as any).HanziWriter;

      strokes.forEach((_: any, idx: number) => {
        const stepBox = document.createElement('div');
        stepBox.className = 'stroke-step-box';

        const numBadge = document.createElement('span');
        numBadge.className = 'step-num';
        numBadge.textContent = `#${idx + 1}`;

        const miniTarget = document.createElement('div');
        miniTarget.className = 'step-svg-target';
        miniTarget.id = `step-target-${idx}`;

        stepBox.appendChild(numBadge);
        stepBox.appendChild(miniTarget);
        stepsContainer.appendChild(stepBox);

        // Render static snapshot with progressive strokes 0 to idx
        if (HanziWriter) {
          const partialData = {
            ...charData,
            strokes: charData.strokes.slice(0, idx + 1),
            medians: charData.medians ? charData.medians.slice(0, idx + 1) : []
          };
          const miniWriter = HanziWriter.create(miniTarget, char, {
            width: 48,
            height: 48,
            padding: 4,
            showOutline: true,
            outlineColor: 'rgba(255, 255, 255, 0.08)',
            strokeColor: '#fda4af',
            charDataLoader: (_c: string, cb: any) => cb(partialData)
          });
          miniWriter.showCharacter();
        }
      });
    }

    // Actions
    if (btnPlay) {
      btnPlay.addEventListener('click', () => {
        if (!currentWriter) return;
        isLooping = false;
        if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Animation läuft...';
        currentWriter.animateCharacter({
          onComplete: () => {
            if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Fertig';
          }
        });
      });
    }

    if (btnStep) {
      btnStep.addEventListener('click', () => {
        if (!currentWriter) return;
        isLooping = false;
        currentWriter.animateCharacter();
      });
    }

    if (btnLoop) {
      btnLoop.addEventListener('click', () => {
        if (!currentWriter) return;
        isLooping = !isLooping;
        if (isLooping) {
          if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Endlosschleife aktiv';
          currentWriter.loopCharacterAnimation();
        } else {
          currentWriter.pauseAnimation();
          if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Schleife pausiert';
        }
      });
    }

    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (!currentWriter) return;
        isLooping = false;
        isQuizActive = false;
        currentWriter.showOutline();
        currentWriter.hideCharacter();
        if (strokeStatusDisplay) strokeStatusDisplay.textContent = 'Zurückgesetzt';
      });
    }

    if (btnQuiz) {
      btnQuiz.addEventListener('click', () => {
        if (!currentWriter) return;
        isQuizActive = true;
        isLooping = false;
        if (strokeStatusDisplay) strokeStatusDisplay.textContent = '✏️ Übungsmodus: Zeichne den 1. Strich!';

        currentWriter.quiz({
          onCorrectStroke: (data: any) => {
            if (strokeStatusDisplay) {
              strokeStatusDisplay.textContent = `✓ Richtig! (${data.strokeNum + 1}/${data.totalStrokes})`;
            }
          },
          onMistake: (data: any) => {
            if (strokeStatusDisplay) {
              strokeStatusDisplay.textContent = `❌ Nicht ganz! Versuche Strich ${data.strokeNum + 1} noch einmal.`;
            }
          },
          onComplete: () => {
            if (strokeStatusDisplay) {
              strokeStatusDisplay.textContent = '🎉 Großartig! Zeichen erfolgreich vervollständigt!';
            }
          }
        });
      });
    }
  }

  setupStrokeGuide();
  document.addEventListener('astro:page-load', setupStrokeGuide);
</script>

<style>
  .stroke-order-guide {
    position: relative;
    z-index: 9999;
  }

  /* Word Kanji Pills */
  .word-kanji-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    background: rgba(225, 29, 72, 0.1);
    border: 1px solid rgba(225, 29, 72, 0.25);
    border-radius: 0.5rem;
    padding: 0.4rem 0.75rem;
  }

  .word-kanji-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fda4af;
  }

  .word-kanji-pills {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .btn-word-kanji {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.35rem;
    padding: 0.15rem 0.55rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--sl-color-white);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global([data-theme='light']) .btn-word-kanji {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .btn-word-kanji:hover,
  .btn-word-kanji.active {
    background: #e11d48;
    border-color: #fda4af;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(225, 29, 72, 0.4);
    transform: translateY(-1px);
  }

  /* Backdrop */
  .stroke-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    z-index: 10000;
  }

  /* Modal Dialog Panel */
  .stroke-modal-panel {
    background: #0f172a;
    border: 1px solid rgba(225, 29, 72, 0.4);
    border-radius: 1.25rem;
    width: 100%;
    max-width: 680px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 1.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(225, 29, 72, 0.15);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    box-sizing: border-box;
  }

  :global([data-theme='light']) .stroke-modal-panel {
    background: #ffffff;
    border-color: rgba(225, 29, 72, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  /* Header */
  .stroke-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.85rem;
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

