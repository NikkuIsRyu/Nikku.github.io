      "duration_ms": 1711.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我也很高兴。",
      "start_ms": 11003.0,
      "end_ms": 12094.0,
      "duration_ms": 1091.0
    },
    {
      "turn_idx": 5,
      "speaker": "B",
      "voice": "male_v1",
      "text": "这是我的名片。",
      "start_ms": 12394.0,
      "end_ms": 13795.0,
      "duration_ms": 1401.0
    },
    {
      "turn_idx": 6,
      "speaker": "C",
      "voice": "male_zs",
      "text": "谢谢。\"Gang Edward Li\"……请问李先生，您是哪国人？",
