{
  "dialogue_id": "Dialogue2_1",
  "total_duration_s": 42.1,
  "sample_rate": 32000,
  "turns_count": 8,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "各位好，我来给二位介绍一下。这位是西门子公司的新同事，韦伯先生。这位是我的老朋友，陈先生。",
      "start_ms": 0.0,
      "end_ms": 8571.0,
      "duration_ms": 8571.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "韦伯先生，您好！我姓陈，名字叫陈明。",
      "start_ms": 9091.0,
      "end_ms": 13317.0,
      "duration_ms": 4226.0
    },
    {
      "turn_idx": 3,
      "speaker": "C",
      "voice": "male_zs",
      "text": "陈先生，幸会，认识您非常高兴！",
      "start_ms": 13837.0,
      "end_ms": 17618.0,
      "duration_ms": 3781.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我也是，见到您很高兴。",
      "start_ms": 18138.0,
      "end_ms": 20179.0,
      "duration_ms": 2041.0
    },
    {
      "turn_idx": 5,
      "speaker": "B",
      "voice": "male_v1",
      "text": "这是我个人的联络卡片，上面有我的手机和邮箱。",
      "start_ms": 20479.0,
      "end_ms": 25615.0,
      "duration_ms": 5136.0
    },
    {
      "turn_idx": 6,
      "speaker": "C",
      "voice": "male_zs",
      "text": "太感谢了！\"Ming Chen\"……冒昧问一下陈先生，您的家乡在哪里？",
      "start_ms": 26135.0,
      "end_ms": 32966.0,
      "duration_ms": 6831.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v4",
      "text": "陈先生出生在新加坡，现在在上海工作。",
      "start_ms": 33586.0,
      "end_ms": 37227.0,
      "duration_ms": 3641.0
    },
    {
      "turn_idx": 8,
      "speaker": "C",
      "voice": "male_zs",
      "text": "原来如此，非常欢迎您加入我们的项目！",
      "start_ms": 37747.0,
      "end_ms": 42103.0,
      "duration_ms": 4356.0
    }
  ]
}