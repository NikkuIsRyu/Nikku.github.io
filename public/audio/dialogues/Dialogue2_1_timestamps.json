    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v3",
      "text": "我介绍一下，这是我朋友李先生，这是宝马公司的克勒先生。",
      "start_ms": 0.0,
      "end_ms": 5651.0,
      "duration_ms": 5651.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "您好！我姓李，叫李刚。",
      "start_ms": 6171.0,
      "end_ms": 8252.0,
      "duration_ms": 2081.0
    },
    {
      "turn_idx": 3,
      "speaker": "C",
      "voice": "male_zs",
      "text": "认识您很高兴。",
