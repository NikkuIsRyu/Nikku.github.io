{
  "dialogue_id": "Dialogue9_2",
  "total_duration_s": 36.86,
  "sample_rate": 32000,
  "turns_count": 9,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "小陈，下课了你还在做什么呢？",
      "start_ms": 0.0,
      "end_ms": 2666.0,
      "duration_ms": 2666.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我正在给女朋友打短信呢。",
      "start_ms": 3286.0,
      "end_ms": 5897.0,
      "duration_ms": 2611.0
    },
    {
      "turn_idx": 3,
      "speaker": "A",
      "voice": "female_v4",
      "text": "哈哈，怪不得这么认真！你们今天晚上有什么安排？",
      "start_ms": 6417.0,
      "end_ms": 10488.0,
      "duration_ms": 4071.0
    },
    {
      "turn_idx": 4,
      "speaker": "C",
      "voice": "male_zs",
      "text": "我们打算吃完晚饭以后去看成龙的新电影。听说这个电影非常有意思。",
      "start_ms": 11108.0,
      "end_ms": 18079.0,
      "duration_ms": 6971.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v4",
      "text": "我晚上正好没安排，我跟你们一起去，好吗？",
      "start_ms": 18599.0,
      "end_ms": 22240.0,
      "duration_ms": 3641.0
    },
    {
      "turn_idx": 6,
      "speaker": "B",
      "voice": "male_v1",
      "text": "好啊，欢迎欢迎！",
      "start_ms": 22860.0,
      "end_ms": 24446.0,
      "duration_ms": 1586.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v4",
      "text": "你们买了几点的电影票？",
      "start_ms": 24966.0,
      "end_ms": 26607.0,
      "duration_ms": 1641.0
    },
    {
      "turn_idx": 8,
      "speaker": "C",
      "voice": "male_zs",
      "text": "这个电影不太长，从晚上八点一刻开始，到十点结束。",
      "start_ms": 27227.0,
      "end_ms": 32343.0,
      "duration_ms": 5116.0
    },
    {
      "turn_idx": 9,
      "speaker": "A",
      "voice": "female_v4",
      "text": "好的，那我八点在电影院门口等你们，不见不散！",
      "start_ms": 32863.0,
      "end_ms": 36859.0,
      "duration_ms": 3996.0
    }
  ]
}