{
  "dialogue_id": "Dialogue4_2",
  "total_duration_s": 43.9,
  "sample_rate": 32000,
  "turns_count": 8,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "赵主管，请问今天是几月几号，周几啊？",
      "start_ms": 0.0,
      "end_ms": 3326.0,
      "duration_ms": 3326.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我想想看，前天周四是我母亲的生日，所以今天应该是二十五号，星期六。",
      "start_ms": 3946.0,
      "end_ms": 11512.0,
      "duration_ms": 7566.0
    },
    {
      "turn_idx": 3,
      "speaker": "A",
      "voice": "female_v4",
      "text": "好像有点不对，手机屏幕上明明显示今天是二十六号，周日呢。",
      "start_ms": 12032.0,
      "end_ms": 17218.0,
      "duration_ms": 5186.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "让我瞧瞧墙上的挂历……哎，这张挂历居然是上个月的！",
      "start_ms": 17738.0,
      "end_ms": 23219.0,
      "duration_ms": 5481.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v4",
      "text": "哈哈，怪不得咱们俩算出来的日子对不上。",
      "start_ms": 23739.0,
      "end_ms": 27070.0,
      "duration_ms": 3331.0
    },
    {
      "turn_idx": 6,
      "speaker": "B",
      "voice": "male_v1",
      "text": "你看桌上最新这份晨报，头版日期清清楚楚写着五月二十六日星期日。",
      "start_ms": 27590.0,
      "end_ms": 34751.0,
      "duration_ms": 7161.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v4",
      "text": "抱歉抱歉，看来真的是我记混了。",
      "start_ms": 35271.0,
      "end_ms": 38047.0,
      "duration_ms": 2776.0
    },
    {
      "turn_idx": 8,
      "speaker": "B",
      "voice": "male_v1",
      "text": "哈哈，小事一桩，不用介意，周末过得糊涂也正常！",
      "start_ms": 38567.0,
      "end_ms": 43903.0,
      "duration_ms": 5336.0
    }
  ]
}