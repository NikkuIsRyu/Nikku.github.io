{
  "dialogue_id": "Dialogue4_2",
  "total_duration_s": 24.03,
  "sample_rate": 32000,
  "turns_count": 8,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v3",
      "text": "刘先生，今天几号，星期几？",
      "start_ms": 0.0,
      "end_ms": 2431.0,
      "duration_ms": 2431.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "今天？昨天星期六，是我妹妹的生日。今天是十号，星期天。",
      "start_ms": 3051.0,
      "end_ms": 9317.0,
      "duration_ms": 6266.0
    },
    {
      "turn_idx": 3,
      "speaker": "A",
      "voice": "female_v3",
      "text": "不对，你看，今天是十一号，星期天。",
      "start_ms": 9837.0,
      "end_ms": 12668.0,
      "duration_ms": 2831.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "这是去年的月历。",
      "start_ms": 13188.0,
      "end_ms": 14864.0,
      "duration_ms": 1676.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v3",
      "text": "是吗？",
      "start_ms": 15384.0,
      "end_ms": 15875.0,
      "duration_ms": 491.0
    },
    {
      "turn_idx": 6,
      "speaker": "B",
      "voice": "male_v1",
      "text": "这是今天的报纸，二〇一〇年一月十日星期天。",
      "start_ms": 16495.0,
      "end_ms": 20886.0,
      "duration_ms": 4391.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v3",
      "text": "哦，对不起。",
      "start_ms": 21406.0,
      "end_ms": 22777.0,
      "duration_ms": 1371.0
    },
    {
      "turn_idx": 8,
      "speaker": "B",
      "voice": "male_v1",
      "text": "没关系。",
      "start_ms": 23297.0,
      "end_ms": 24028.0,
      "duration_ms": 731.0
    }
  ]
}