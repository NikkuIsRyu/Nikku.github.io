{
  "dialogue_id": "Dialogue6_1",
  "total_duration_s": 58.42,
  "sample_rate": 32000,
  "turns_count": 10,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "各位同事，工业博览会的项目负责人什么时候到我们公司？",
      "start_ms": 0.0,
      "end_ms": 4401.0,
      "duration_ms": 4401.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "负责人前天已经从北方出发了，可能后天上午就会来到上海。",
      "start_ms": 5021.0,
      "end_ms": 11192.0,
      "duration_ms": 6171.0
    },
    {
      "turn_idx": 3,
      "speaker": "C",
      "voice": "male_zs",
      "text": "听说这次展览会规模特别大，很多外贸企业和商业代表都会去。",
      "start_ms": 11712.0,
      "end_ms": 18018.0,
      "duration_ms": 6306.0
    },
    {
      "turn_idx": 4,
      "speaker": "A",
      "voice": "female_v4",
      "text": "咱们部门这次打算在上海待几天左右？",
      "start_ms": 18538.0,
      "end_ms": 21529.0,
      "duration_ms": 2991.0
    },
    {
      "turn_idx": 5,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我们计划先在展厅待四天，认真参观各个高新技术展区。",
      "start_ms": 22149.0,
      "end_ms": 28215.0,
      "duration_ms": 6066.0
    },
    {
      "turn_idx": 6,
      "speaker": "C",
      "voice": "male_zs",
      "text": "之后如果工作顺利，大家想不想一起去周围的南方城市看看？",
      "start_ms": 28735.0,
      "end_ms": 33891.0,
      "duration_ms": 5156.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v4",
      "text": "我非常想去绍兴或者杭州走走，今年秋天的气候正适合出门旅游。",
      "start_ms": 34511.0,
      "end_ms": 40147.0,
      "duration_ms": 5636.0
    },
    {
      "turn_idx": 8,
      "speaker": "B",
      "voice": "male_v1",
      "text": "为什么选秋天呢？因为那边的秋天景色很美，而且天气也不算太热。",
      "start_ms": 40667.0,
      "end_ms": 47868.0,
      "duration_ms": 7201.0
    },
    {
      "turn_idx": 9,
      "speaker": "C",
      "voice": "male_zs",
      "text": "赞成，那我今天先把参展的行程安排详细告诉部门主管。",
      "start_ms": 48388.0,
      "end_ms": 54169.0,
      "duration_ms": 5781.0
    },
    {
      "turn_idx": 10,
      "speaker": "A",
      "voice": "female_v4",
      "text": "好的，大家分头准备好相关的外贸宣传材料吧！",
      "start_ms": 54689.0,
      "end_ms": 58425.0,
      "duration_ms": 3736.0
    }
  ]
}