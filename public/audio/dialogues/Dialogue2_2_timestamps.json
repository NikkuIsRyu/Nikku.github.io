  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v3",
      "text": "她的英语非常好，她叫什么名字？",
      "start_ms": 0.0,
      "end_ms": 3106.0,
      "duration_ms": 3106.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "她叫佐藤燕玲，是我们公司的翻译。",
      "start_ms": 3726.0,
      "end_ms": 7557.0,
      "duration_ms": 3831.0
    },
    {
      "turn_idx": 3,
      "speaker": "A",
      "voice": "female_v3",
      "text": "佐藤燕玲……她是中国人还是日本人？",
      "start_ms": 8077.0,
      "end_ms": 11513.0,
      "duration_ms": 3436.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "她是中国人，她说汉语、英语和日语。",
      "start_ms": 12133.0,
      "end_ms": 15784.0,
      "duration_ms": 3651.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v3",
      "text": "\"佐藤燕玲\"是日本名字吧？",
      "start_ms": 16304.0,
      "end_ms": 18430.0,
      "duration_ms": 2126.0
    },
    {
      "turn_idx": 6,
      "speaker": "B",
      "voice": "male_v1",
      "text": "是，她爸爸是日本人，妈妈是中国人。",
      "start_ms": 19050.0,
      "end_ms": 22791.0,
      "duration_ms": 3741.0
    }
  ]
}