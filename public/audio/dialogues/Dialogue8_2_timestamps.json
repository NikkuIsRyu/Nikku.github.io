{
  "dialogue_id": "Dialogue8_2",
  "total_duration_s": 52.92,
  "sample_rate": 32000,
  "turns_count": 9,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "老板，请问这些杭州丝绸领带今天打折吗？",
      "start_ms": 0.0,
      "end_ms": 3571.0,
      "duration_ms": 3571.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "打八折，今天特价，一百六十块一条，非常便宜！你们喜欢什么颜色？红的、灰的还是深蓝的？",
      "start_ms": 4191.0,
      "end_ms": 14202.0,
      "duration_ms": 10011.0
    },
    {
      "turn_idx": 3,
      "speaker": "C",
      "voice": "male_zs",
      "text": "一百六十块一条？太贵了！六十块一条怎么样？",
      "start_ms": 14822.0,
      "end_ms": 20463.0,
      "duration_ms": 5641.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "六十块一条？！那肯定不卖，这是真丝的！",
      "start_ms": 21083.0,
      "end_ms": 25454.0,
      "duration_ms": 4371.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v4",
      "text": "上面挂着的那件深蓝色的衬衫看起来不错，请给我看看。我可以试试吗？",
      "start_ms": 25974.0,
      "end_ms": 31850.0,
      "duration_ms": 5876.0
    },
    {
      "turn_idx": 6,
      "speaker": "C",
      "voice": "male_zs",
      "text": "颜色很好看，穿在你身上挺合适的！老板，这件衬衫打几折？",
      "start_ms": 32470.0,
      "end_ms": 38731.0,
      "duration_ms": 6261.0
    },
    {
      "turn_idx": 7,
      "speaker": "B",
      "voice": "male_v1",
      "text": "给你们打五折，一件六十块，如果买两件只要一百块。",
      "start_ms": 39351.0,
      "end_ms": 45262.0,
      "duration_ms": 5911.0
    },
    {
      "turn_idx": 8,
      "speaker": "C",
      "voice": "male_zs",
      "text": "还是不便宜，算了，我们再去别的商店看看吧。",
      "start_ms": 45782.0,
      "end_ms": 49733.0,
      "duration_ms": 3951.0
    },
    {
      "turn_idx": 9,
      "speaker": "B",
      "voice": "male_v1",
      "text": "哎呀，现在的老外真会讲价！",
      "start_ms": 50253.0,
      "end_ms": 52924.0,
      "duration_ms": 2671.0
    }
  ]
}