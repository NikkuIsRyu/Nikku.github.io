{
  "dialogue_id": "Dialogue10_1",
  "total_duration_s": 54.11,
  "sample_rate": 32000,
  "turns_count": 9,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "我们坐靠窗的这张桌子吧，这儿比门口那边安静，而且也很干净。",
      "start_ms": 0.0,
      "end_ms": 5471.0,
      "duration_ms": 5471.0
    },
    {
      "turn_idx": 2,
      "speaker": "C",
      "voice": "male_zs",
      "text": "两位中午好！请问你们想吃点什么？请先看看菜单。",
      "start_ms": 5991.0,
      "end_ms": 11667.0,
      "duration_ms": 5676.0
    },
    {
      "turn_idx": 3,
      "speaker": "B",
      "voice": "male_v1",
      "text": "抱歉，有些手写的菜名我看不懂。你能不能给我们介绍一下你们这儿的特色菜？",
      "start_ms": 12187.0,
      "end_ms": 20113.0,
      "duration_ms": 7926.0
    },
    {
      "turn_idx": 4,
      "speaker": "C",
      "voice": "male_zs",
      "text": "没问题！我们饭店最有名的特色是正宗四川菜。",
      "start_ms": 20733.0,
      "end_ms": 25209.0,
      "duration_ms": 4476.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v4",
      "text": "请问有没有素菜？我这位同事今天不吃肉，想吃清淡一点的。",
      "start_ms": 25729.0,
      "end_ms": 31075.0,
      "duration_ms": 5346.0
    },
    {
      "turn_idx": 6,
      "speaker": "C",
      "voice": "male_zs",
      "text": "有啊，我们的炒白菜和蘑菇豆腐都很好吃。请问你们要几个菜？",
      "start_ms": 31595.0,
      "end_ms": 38201.0,
      "duration_ms": 6606.0
    },
    {
      "turn_idx": 7,
      "speaker": "B",
      "voice": "male_v1",
      "text": "先来两个素菜，再来一碗酸辣汤。汤请不要做得太辣。",
      "start_ms": 38821.0,
      "end_ms": 44837.0,
      "duration_ms": 6016.0
    },
    {
      "turn_idx": 8,
      "speaker": "C",
      "voice": "male_zs",
      "text": "好的。你们要不要尝尝我们这儿最有名的四川担担面？",
      "start_ms": 45357.0,
      "end_ms": 50028.0,
      "duration_ms": 4671.0
    },
    {
      "turn_idx": 9,
      "speaker": "A",
      "voice": "female_v4",
      "text": "好主意，那就再来两份担担面和两双筷子！",
      "start_ms": 50648.0,
      "end_ms": 54114.0,
      "duration_ms": 3466.0
    }
  ]
}