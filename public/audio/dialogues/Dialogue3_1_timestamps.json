{
  "dialogue_id": "Dialogue3_1",
  "total_duration_s": 30.67,
  "sample_rate": 32000,
  "turns_count": 8,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "大卫，新商务会展中心的宣传册放在哪儿了？",
      "start_ms": 0.0,
      "end_ms": 3341.0,
      "duration_ms": 3341.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "就在电脑旁边的那本文件夹里。",
      "start_ms": 3961.0,
      "end_ms": 7072.0,
      "duration_ms": 3111.0
    },
    {
      "turn_idx": 3,
      "speaker": "A",
      "voice": "female_v4",
      "text": "上面写了服务总台的联系电话吗？",
      "start_ms": 7592.0,
      "end_ms": 10063.0,
      "duration_ms": 2471.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我看一下，总台的座机号码是八七三二零零九。",
      "start_ms": 10683.0,
      "end_ms": 15804.0,
      "duration_ms": 5121.0
    },
    {
      "turn_idx": 5,
      "speaker": "A",
      "voice": "female_v4",
      "text": "那他们市场部门的分机号是多少呢？",
      "start_ms": 16324.0,
      "end_ms": 18840.0,
      "duration_ms": 2516.0
    },
    {
      "turn_idx": 6,
      "speaker": "B",
      "voice": "male_v1",
      "text": "市场部的分机是六六八五，你记一下。",
      "start_ms": 19460.0,
      "end_ms": 23291.0,
      "duration_ms": 3831.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v4",
      "text": "好的，我马上给他们打个电话确认一下。",
      "start_ms": 23811.0,
      "end_ms": 26932.0,
      "duration_ms": 3121.0
    },
    {
      "turn_idx": 8,
      "speaker": "B",
      "voice": "male_v1",
      "text": "没问题，如果占线就发邮件联系。",
      "start_ms": 27452.0,
      "end_ms": 30673.0,
      "duration_ms": 3221.0
    }
  ]
}