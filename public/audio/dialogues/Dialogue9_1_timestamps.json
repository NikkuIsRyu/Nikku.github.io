{
  "dialogue_id": "Dialogue9_1",
  "total_duration_s": 41.47,
  "sample_rate": 32000,
  "turns_count": 8,
  "turns": [
    {
      "turn_idx": 1,
      "speaker": "A",
      "voice": "female_v4",
      "text": "两位同事，你们这个星期六还要上班吗？",
      "start_ms": 0.0,
      "end_ms": 3286.0,
      "duration_ms": 3286.0
    },
    {
      "turn_idx": 2,
      "speaker": "B",
      "voice": "male_v1",
      "text": "我星期六上午要上早班，一直上到中午十二点。有什么事吗？",
      "start_ms": 3906.0,
      "end_ms": 10112.0,
      "duration_ms": 6206.0
    },
    {
      "turn_idx": 3,
      "speaker": "A",
      "voice": "female_v4",
      "text": "我想请你们两位去市中心的四川饭店吃午饭。",
      "start_ms": 10732.0,
      "end_ms": 14213.0,
      "duration_ms": 3481.0
    },
    {
      "turn_idx": 4,
      "speaker": "B",
      "voice": "male_v1",
      "text": "哦，非常抱歉，星期六下午两点我跟客户有个约会，可能没空。",
      "start_ms": 14733.0,
      "end_ms": 21379.0,
      "duration_ms": 6646.0
    },
    {
      "turn_idx": 5,
      "speaker": "C",
      "voice": "male_zs",
      "text": "那么星期天中午你们有空吗？星期天大家都不上班。",
      "start_ms": 21899.0,
      "end_ms": 27130.0,
      "duration_ms": 5231.0
    },
    {
      "turn_idx": 6,
      "speaker": "B",
      "voice": "male_v1",
      "text": "星期天中午我有空！那我们怎么见面？",
      "start_ms": 27650.0,
      "end_ms": 31521.0,
      "duration_ms": 3871.0
    },
    {
      "turn_idx": 7,
      "speaker": "A",
      "voice": "female_v4",
      "text": "我星期天十一点半先开车去接你们，然后我们一起去饭店。",
      "start_ms": 32141.0,
      "end_ms": 36977.0,
      "duration_ms": 4836.0
    },
    {
      "turn_idx": 8,
      "speaker": "C",
      "voice": "male_zs",
      "text": "那太好了！我们星期天十一点半在门口见。",
      "start_ms": 37497.0,
      "end_ms": 41473.0,
      "duration_ms": 3976.0
    }
  ]
}